#include "../std.scmlh"

:MAIN
03E5: "03A4: name_thread 'MAIN'"
03E5: "01F0: set_max_wanted_level_to 6"
03E5: "0111: toggle_wasted_busted_check 0"
03E5: "00C0: set_current_time_hours_to 23 minutes_to 0"
03E5: "04E4/03CB/0053/01F5/07AF bootstrap mirrored"
03E5: "087B/070D/01B4 wardrobe + player rebuild mirrored"
03E5: "0A8C/0AC6 HUDHOOK + memory patch sequence mirrored"

0B14: 16 $GRID
0B13: $GRID 0 2
0B13: $GRID 1 4
0B13: $GRID 2 6
0B13: $GRID 3 8
0B13: $GRID 4 10
0B13: $GRID 5 12
0B13: $GRID 6 14
0B13: $GRID 7 16
0B13: $GRID 8 1
0B13: $GRID 9 3
0B13: $GRID 10 5
0B13: $GRID 11 7
0B13: $GRID 12 9
0B13: $GRID 13 11
0B13: $GRID 14 13
0B13: $GRID 15 15

0004: $IDX 0
0004: $EVEN_TOTAL 0
0004: $ODD_TOTAL 0
:MAIN_LOOP
IF_LT($IDX, 16, @CHECK_GARAGE)
000A: @POST_SCAN
:CHECK_GARAGE
0B12: $CELL $GRID $IDX
IF_LT($CELL, 9, @ADD_EVENISH)
0006: $ODD_TOTAL $ODD_TOTAL $CELL
000A: @NEXT_GARAGE
:ADD_EVENISH
0006: $EVEN_TOTAL $EVEN_TOTAL $CELL
:NEXT_GARAGE
0006: $IDX $IDX 1
000A: @MAIN_LOOP
:POST_SCAN

0D00: @DOGARAGE
0D00: @DOPROJECTION
0D00: @ADDLINE
0D00: @TP

EVENT_BIND("HUDHOOK", @HUDHOOK)
EVENT_BIND("HUDHOOK", @HUCALL)
TRIGGER_EVENT("HUDHOOK")

03E5: "EVEN_TOTAL"
03E5: $EVEN_TOTAL
03E5: "ODD_TOTAL"
03E5: $ODD_TOTAL
03E5: "CURRENT_VERTEX_COUNT"
03E5: $CURRENT_VERTEX_COUNT
END_SCRIPT()

:HUDHOOK
03E5: "HUDHOOK visual clone branch A"
0D02:

:HUCALL
03E5: "HUHOOKRETURNJUMP visual clone branch B"
0D02:

:DOGARAGE
0008: $WORLD_X $EVEN_TOTAL 5
0008: $WORLD_Y $ODD_TOTAL 3
0006: $WORLD_Z $WORLD_X $WORLD_Y
0D01:

:DOPROJECTION
0009: $SCREEN_X $WORLD_X 2
0009: $SCREEN_Y $WORLD_Y 2
0006: $SCREEN_X $SCREEN_X 77
0006: $SCREEN_Y $SCREEN_Y 33
0D01:

:ADDLINE
0C00: 3 $HEAP
0C01: $HEAP 0 $SCREEN_X
0C01: $HEAP 1 $SCREEN_Y
0C01: $HEAP 2 $WORLD_Z
0C02: $CURRENT_VERTEX_COUNT $HEAP 2
FREE($HEAP)
0D01:

:TP
IF_GT($CURRENT_VERTEX_COUNT, 120, @TP_MOVE)
0006: $CURRENT_VERTEX_COUNT $CURRENT_VERTEX_COUNT 9
0D01:
:TP_MOVE
0009: $CURRENT_VERTEX_COUNT $CURRENT_VERTEX_COUNT 3
03E5: "TP_MOVE alternate behavior"
0D01:
