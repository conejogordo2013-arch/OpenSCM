{
  "Main Loop": {
    "prefix": "mainloop",
    "body": [":MAIN", "0004: counter 0", ":LOOP", "03E5: \"tick\"", "0006: counter counter 1", "00D8: 3 counter @LOOP", "0001:"],
    "description": "Basic SCML main loop"
  },
  "Macro": {
    "prefix": "scmacro",
    "body": ["macro ${1:name}(${2:arg}):", "    ${3:03E5: \"${1:name}\" ${2:arg}}", "endmacro"],
    "description": "SCML macro template"
  },
  "Ifdef Block": {
    "prefix": "ifdef",
    "body": ["#ifdef ${1:SYMBOL}", "    ${2:03E5: \"enabled\"}", "#else", "    ${3:03E5: \"disabled\"}", "#endif"],
    "description": "Preprocessor ifdef"
  },
  "Async Task Pair": {
    "prefix": "asyncpair",
    "body": ["ASYNC_SPAWN(@${1:WORKER}, ${2:$TASK})", ":${1:WORKER}", "    ${3:03E5: \"work\"}", "    END_THREAD()"],
    "description": "Spawn a cooperative async task and declare its label"
  },
  "Typed Integer": {
    "prefix": "leti32",
    "body": ["LET_I32(${1:$NAME}, ${2:0})"],
    "description": "Declare and initialize a statically checked i32"
  },
  "Typed String": {
    "prefix": "letstr",
    "body": ["LET_STR(${1:$NAME}, \"${2:value}\")"],
    "description": "Declare and initialize a statically checked string"
  },
  "Type Assert": {
    "prefix": "typeassert",
    "body": ["TYPE_ASSERT(${1:$VALUE}, \"${2|i32,f32,str,any|}\", ${3:$OK})"],
    "description": "Runtime SCML type assertion"
  }
}
