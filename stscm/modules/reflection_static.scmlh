; reflection_static.scmlh - static reflection/metaobject helpers.
#pragma once

macro static_reflect_type(lhs_value, rhs_value, out_value) {
    0B31: "reflection.static_reflect_type" lhs_value rhs_value
    0004: out_value $RETVAL
}

