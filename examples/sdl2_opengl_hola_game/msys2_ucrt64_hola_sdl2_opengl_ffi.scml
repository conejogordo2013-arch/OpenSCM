0004: $SCORE 0
0004: $FRAME 0.0
0004: $SEED 1337
0004: $STALKER_ACTIVE 0
0004: $STALKER_X 120.0
0004: $STALKER_Z 120.0
0004: $MONO_ACTIVE 0
0004: $MONO_X -110.0
0004: $MONO_Y 160.0
0004: $MONO_Z -130.0

