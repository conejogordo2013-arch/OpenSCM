#include "../std.scmlh"

:MAIN
03E5: "03A4: name_thread 'MAIN'"
03E5: "01F0: set_max_wanted_level_to 6"
03E5: "0111: toggle_wasted_busted_check 0"
03E5: "00C0: set_current_time_hours_to 23 minutes_to 0"

0004: $PLAYER_CHAR 1
0004: $PLAYER_ACTOR 2
0004: $PLAYER_GROUP 7
0004: $ONMISSION 1
0004: $DEFAULT_WAIT_TIME 250
0004: $CURRENT_VERTEX_COUNT 0

03E5: "Boot scene + player skin setup emulated"
03E5: "Garage scan + HUD hook routine emulated"

0B14: 12 $MISSION_GRID
0B13: $MISSION_GRID 0 4
0B13: $MISSION_GRID 1 6
0B13: $MISSION_GRID 2 10
0B13: $MISSION_GRID 3 12
0B13: $MISSION_GRID 4 9
0B13: $MISSION_GRID 5 3
0B13: $MISSION_GRID 6 7
0B13: $MISSION_GRID 7 8
0B13: $MISSION_GRID 8 14
0B13: $MISSION_GRID 9 1
0B13: $MISSION_GRID 10 5
0B13: $MISSION_GRID 11 11

0004: $IDX 0
0004: $THREAT_ACCUM 0
:MAIN_LOOP
IF_LT($IDX, 12, @CHECK_GARAGE)
000A: @AFTER_GARAGE_SCAN
:CHECK_GARAGE
0B12: $TEMP_CELL $MISSION_GRID $IDX
0006: $THREAT_ACCUM $THREAT_ACCUM $TEMP_CELL
0006: $IDX $IDX 1
000A: @MAIN_LOOP
:AFTER_GARAGE_SCAN

0D00: @DOGARAGE
0D00: @DOPROJECTION
0D00: @ADDLINE
0D00: @TP

EVENT_BIND("HUDHOOK", @HUDHOOK)
EVENT_BIND("HUDHOOK", @HUCALL)
TRIGGER_EVENT("HUDHOOK")

03E5: "THREAT_ACCUM"
03E5: $THREAT_ACCUM
03E5: "CURRENT_VERTEX_COUNT"
03E5: $CURRENT_VERTEX_COUNT
END_SCRIPT()

:HUDHOOK
03E5: "HUDHOOK active"
03E5: "NUMVERTICES push simulated"
0D02:

:HUCALL
03E5: "HUHOOKRETURNJUMP linked"
0D02:

:DOGARAGE
0008: $WORLD_X $THREAT_ACCUM 2
0008: $WORLD_Y $THREAT_ACCUM 3
0008: $WORLD_Z $THREAT_ACCUM 4
0009: $WORLD_X $WORLD_X 2
0009: $WORLD_Y $WORLD_Y 3
0009: $WORLD_Z $WORLD_Z 4
0D01:

:DOPROJECTION
0006: $SCREEN_X $WORLD_X 100
0006: $SCREEN_Y $WORLD_Y 50
0009: $SCREEN_X $SCREEN_X 2
0009: $SCREEN_Y $SCREEN_Y 2
0D01:

:ADDLINE
0C00: 4 $LINE_HEAP
0C01: $LINE_HEAP 0 $SCREEN_X
0C01: $LINE_HEAP 1 $SCREEN_Y
0C01: $LINE_HEAP 2 $WORLD_Z
0C01: $LINE_HEAP 3 $THREAT_ACCUM
0C02: $CURRENT_VERTEX_COUNT $LINE_HEAP 3
FREE($LINE_HEAP)
0D01:

:TP
IF_GT($CURRENT_VERTEX_COUNT, 60, @TP_MOVE)
0006: $CURRENT_VERTEX_COUNT $CURRENT_VERTEX_COUNT 5
0D01:
:TP_MOVE
0009: $CURRENT_VERTEX_COUNT $CURRENT_VERTEX_COUNT 2
03E5: "TP_MOVE invoked"
0D01:
