use "../std.scmlh";

:MAIN
03E5: "\x1b[2J"
0004: $RUN 1
0004: $A 0
0004: $B 0
0004: $C 0
0004: $FRAME 0
0004: $WIDTH 160
0004: $HEIGHT 44
0004: $SIZE 7040
0B14: 7040 $BUFFER
0B14: 7040 $ZBUF

:LOOP
00D6: $RUN 0 @END

; clear frame buffers
0004: $I 0
:CLEAR_LOOP
00D9: $I $SIZE @CLEAR_BODY
000A: @CLEAR_DONE
:CLEAR_BODY
0B13: $BUFFER $I 46
0B13: $ZBUF $I 0
0006: $I $I 1
000A: @CLEAR_LOOP
:CLEAR_DONE

; lightweight animated placeholder of triple cube sweep using fixed-point lanes
0004: $X 0
:SCAN_LOOP
00D9: $X 240 @SCAN_BODY
000A: @SCAN_DONE
:SCAN_BODY
0007: 10@ $X 160
0008: 11@ 10@ 44
0007: 12@ 11@ 7040
0B13: $BUFFER 12@ 64

0006: 13@ 12@ 13
00D9: 13@ 7040 @P2
000A: @P2D
:P2
0B13: $BUFFER 13@ 35
:P2D

0006: 14@ 12@ 29
00D9: 14@ 7040 @P3
000A: @P3D
:P3
0B13: $BUFFER 14@ 43
:P3D

0006: $X $X 1
000A: @SCAN_LOOP
:SCAN_DONE

03E5: "\x1b[H"
0004: $K 0
:PRINT_LOOP
00D9: $K $SIZE @PRINT_BODY
000A: @PRINT_DONE
:PRINT_BODY
0B12: 20@ $BUFFER $K
03E5: 20@
0006: $K $K 1
000A: @PRINT_LOOP
:PRINT_DONE

0006: $A $A 5
0006: $B $B 5
0006: $C $C 1
000B: 16
0006: $FRAME $FRAME 1
00D9: $FRAME 200 @LOOP
0004: $RUN 0
000A: @LOOP

:END
0B11: $BUFFER
0B11: $ZBUF
0D02:
