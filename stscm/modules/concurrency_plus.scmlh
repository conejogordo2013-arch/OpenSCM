; concurrency_plus.scmlh - atomics, memory model, sync and structured async helpers.
#pragma once

macro atomic_ref_load(lhs_value, rhs_value, out_value) {
    0B31: "concurrency.atomic_ref_load" lhs_value rhs_value
    0004: out_value $RETVAL
}

