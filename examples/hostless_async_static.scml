use "../std.scmlh";

script MAIN {
    let $TOTAL: i32 = 0;
    let $TITLE: str = "SCML hostless async/static demo";
    print($TITLE);
    spawn WORKER_A -> $TASK_A;
    spawn WORKER_B -> $TASK_B;

    :MAIN_WAIT
    async_done($TASK_A, $DONE_A)
    async_done($TASK_B, $DONE_B)
    00D6: $DONE_A 1 @CHECK_B
    wait(1);
    goto MAIN_WAIT;

    :CHECK_B
    00D6: $DONE_B 1 @ALL_DONE
    wait(1);
    goto MAIN_WAIT;

    :ALL_DONE
    type_assert($TOTAL, "i32", $TYPE_OK)
    print("TOTAL");
    print($TOTAL);
    print("TYPE_OK");
    print($TYPE_OK);
}

task WORKER_A {
    let local_a: i32 = 40;
    0006: $TOTAL $TOTAL local_a
}

task WORKER_B {
    let local_b: i32 = 2;
    0006: $TOTAL $TOTAL local_b
}
