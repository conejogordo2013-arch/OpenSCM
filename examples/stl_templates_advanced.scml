#include "../std.scmlh"

:MAIN
TEMPLATE_DECLARE(T_I32, "int32")
VAR_DECL(T_I32, 0@, 10)

VECTOR_T_NEW(T_I32, 32, 1@)
VECTOR_T_PUSH(T_I32, 1@, 11, @TYPE_FAIL)
VECTOR_T_PUSH(T_I32, 1@, 22, @TYPE_FAIL)
VECTOR_T_GET(T_I32, 2@, 1@, 1, @TYPE_FAIL)
PRINT(2@)

OPTIONAL_T_SOME(T_I32, 77, 3@)
OPTIONAL_T_UNWRAP(T_I32, 4@, 3@, @NONE_FAIL)
PRINT(4@)

MAP_T_NEW(T_I32, T_I32, 64, 5@)
MAP_T_PUT_I32(5@, 1001, 42)
MAP_T_PUT_I32(5@, 1002, 88)
PRINT("STL template layer OK")
END_THREAD()

:TYPE_FAIL
PRINT("type mismatch")
END_THREAD()

:NONE_FAIL
PRINT("optional none")
END_THREAD()
