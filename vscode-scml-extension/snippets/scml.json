{
  "Main Loop": {
    "prefix": "mainloop",
    "body": [
      ":MAIN",
      "0004: counter 0",
      ":LOOP",
      "03E5: \"tick\"",
      "0006: counter counter 1",
      "00D8: 3 counter @LOOP",
      "0001:"
    ],
    "description": "Basic SCML main loop"
  },
  "Macro": {
    "prefix": "scmacro",
    "body": [
      "macro ${1:name}(${2:arg}):",
      "    ${3:03E5: \"${1:name}\" ${2:arg}}",
      "endmacro"
    ],
    "description": "SCML macro template"
  },
  "Ifdef Block": {
    "prefix": "ifdef",
    "body": [
      "#ifdef ${1:SYMBOL}",
      "    ${2:03E5: \"enabled\"}",
      "#else",
      "    ${3:03E5: \"disabled\"}",
      "#endif"
    ],
    "description": "Preprocessor ifdef"
  },
  "Async Task Pair": {
    "prefix": "asyncpair",
    "body": [
      "ASYNC_SPAWN(@${1:WORKER}, ${2:$TASK})",
      ":${1:WORKER}",
      "    ${3:03E5: \"work\"}",
      "    END_THREAD()"
    ],
    "description": "Spawn a cooperative async task and declare its label"
  },
  "Typed Integer": {
    "prefix": "leti32",
    "body": [
      "LET_I32(${1:$NAME}, ${2:0})"
    ],
    "description": "Declare and initialize a statically checked i32"
  },
  "Typed String": {
    "prefix": "letstr",
    "body": [
      "LET_STR(${1:$NAME}, \"${2:value}\")"
    ],
    "description": "Declare and initialize a statically checked string"
  },
  "Type Assert": {
    "prefix": "typeassert",
    "body": [
      "TYPE_ASSERT(${1:$VALUE}, \"${2|i32,f32,str,any|}\", ${3:$OK})"
    ],
    "description": "Runtime SCML type assertion"
  },
  "Modern Script": {
    "prefix": "scscript",
    "body": [
      "use \"std.scmlh\";",
      "",
      "script ${1:MAIN} {",
      "    let ${2:$COUNT}: ${3|i32,u32,f32,f64,str,bool,ref,array<any>|} = ${4:0};",
      "    print(${5:\"hello modern SCML\"});",
      "}"
    ],
    "description": "Modern SCML script block lowered to legacy opcodes"
  },
  "Modern If Else": {
    "prefix": "scif",
    "body": [
      "if (${1:$A} ${2|==,!=,>,<,>=,<=|} ${3:$B}) {",
      "    ${4:print(\"true\");}",
      "} else {",
      "    ${5:log(\"false\");}",
      "}"
    ],
    "description": "Modern SCML if/else block"
  },
  "Modern Function": {
    "prefix": "scfn",
    "body": [
      "fn ${1:HELPER}() {",
      "    ${2:print(\"helper\");}",
      "}"
    ],
    "description": "Modern SCML function label block"
  },
  "Modern For Loop": {
    "prefix": "scfor",
    "body": [
      "for (let ${1:$I}: i32 = ${2:0}; ${1:$I} < ${3:10}; ${1:$I}++) {",
      "    ${4:print(${1:$I});}",
      "}"
    ],
    "description": "Modern SCML for loop"
  },
  "Modern Else If Chain": {
    "prefix": "scelseif",
    "body": [
      "if (${1:$VALUE} == ${2:0}) {",
      "    ${3:print(\"zero\");}",
      "} else if (${1:$VALUE} == ${4:1}) {",
      "    ${5:print(\"one\");}",
      "} else {",
      "    ${6:print(\"other\");}",
      "}"
    ],
    "description": "Modern SCML if/else-if/else chain"
  },
  "FFI Declare": {
    "prefix": "ffideclare",
    "body": [
      "0B31: \"ffi.declare\" \"${1:function_name}\" \"${2|int,i64,float,double,pointer,string,void|}\" \"${3:int,int}\""
    ],
    "description": "Declare a reusable FFI signature"
  },
  "FFI Load Library": {
    "prefix": "ffiload",
    "body": [
      "0B31: \"ffi.add_search_path\" \"${1:examples}\"",
      "0B31: \"ffi.load\" \"${2:library_name}\""
    ],
    "description": "Add an FFI search path and load a dynamic library"
  },
  "SCML FFI Header Macro": {
    "prefix": "scffiheader",
    "body": [
      "macro ${1:LIB_LOAD}():",
      "    0B31: \"ffi.add_search_path\" \"${2:native}\"",
      "    0B31: \"ffi.load\" \"${3:library}\"",
      "    0B31: \"ffi.declare\" \"${4:function_name}\" \"${5|int,float,double,pointer,string,void|}\" \"${6:int}\"",
      "endmacro"
    ],
    "description": "SCML-only wrapper macro for an FFI library"
  }
}
