#pragma once
use "../std.scmlh";

#define MEGA_NS_ROOT "OpenSCM::Mega"
#define MEGA_STD_READY 1
#define MEGA_ASCII_W 120
#define MEGA_ASCII_H 36
#define MEGA_ASCII_SIZE 4320

macro MEGA_BOOTSTRAP(tag) {
PRINT("MEGA_BOOTSTRAP")
PRINT(tag)
PRINT(MEGA_NS_ROOT)
}

macro MEGA_ASCII_ALLOC(buffer, zbuf) {
0B14: MEGA_ASCII_SIZE buffer
0B14: MEGA_ASCII_SIZE zbuf
}

macro MEGA_ASCII_FREE(buffer, zbuf) {
0B11: buffer
0B11: zbuf
}
