#include "../std.scmlh"

:MAIN
PRINT("std.scmlh demo")
SET($counter, 0)
ARRAY_NEW(3, $values)
ARRAY_SET($values, 0, 7)
ARRAY_SET($values, 1, 11)
ARRAY_SET($values, 2, 13)
gosub @SUM_VALUES
IF_ELSE_GT($total, 20, @BIG_TOTAL, @SMALL_TOTAL)

:BIG_TOTAL
PRINT("total is big")
goto @DONE

:SMALL_TOTAL
PRINT("total is small")

:DONE
PRINT($total)
END_SCRIPT()

:SUM_VALUES
SET($i, 0)
SET($total, 0)

:SUM_LOOP
ARRAY_GET($item, $values, $i)
ADD($total, $total, $item)
ADD($i, $i, 1)
IF_LT($i, 3, @SUM_LOOP)
RETURN()
