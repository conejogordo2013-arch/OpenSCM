#pragma scml rtti_pointers_complex

#define __scml 1
#define BUILD_NAME "RTTI_POINTERS_COMPLEX"
#define MAX_OBJECTS 12
#define MAX_EVENTS 256
#define OBJ_TYPE_NONE 0
#define OBJ_TYPE_PLAYER 1
#define OBJ_TYPE_ENEMY 2
#define OBJ_TYPE_BOSS 3
#define EVT_BOOT 1
#define EVT_TICK 2
#define EVT_DAMAGE 3
#define EVT_KILL 4
#define EVT_END 5

macro LOG(msg):
    03E5: msg
endmacro

macro LOGV(v):
    03E5: v
endmacro

macro SETI(dst,val):
    0004: dst val
endmacro

macro ADDI(dst,a,b):
    0006: dst a b
endmacro

macro SUBI(dst,a,b):
    0007: dst a b
endmacro

macro JMP(lbl):
    JUMP lbl
endmacro

macro RET():
    0D01:
endmacro

macro ENDT():
    0D02:
endmacro

macro WAIT0():
    000B: 0
endmacro

macro ARR_SET(arr,idx,val):
    0B13: arr idx val
endmacro

macro ARR_GET(out,arr,idx):
    0B12: out arr idx
endmacro

macro PUSH_EVT(code):
    ADDI($EVT_COUNT,$EVT_COUNT,1)
    SUBI(90@,$EVT_COUNT,1)
    ARR_SET($ARR_EVT,90@,code)
endmacro
