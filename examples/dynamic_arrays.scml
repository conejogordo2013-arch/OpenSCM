use "../std.scmlh";

script MAIN {
    vector_new(numbers, 4);
    vector_push(numbers, 10);
    vector_push(numbers, 20);
    vector_push(numbers, 30);

    vector_size(count, numbers);
    print(count);
    vector_get(second, numbers, 1);
    print(second);
    vector_pop(last, numbers);
    print(last);
    vector_size(count_after_pop, numbers);
    print(count_after_pop);
    array_set(numbers, 3, 99);
    vector_get(updated, numbers, 1);
    print(updated);
    heap_free(numbers);
}
