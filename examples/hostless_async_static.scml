#include "../std.scmlh"

:MAIN
LET_I32($TOTAL, 0)
LET_STR($TITLE, "SCML hostless async/static demo")
PRINT($TITLE)
ASYNC_SPAWN(@WORKER_A, $TASK_A)
ASYNC_SPAWN(@WORKER_B, $TASK_B)
:MAIN_WAIT
ASYNC_DONE($TASK_A, $DONE_A)
ASYNC_DONE($TASK_B, $DONE_B)
00D6: $DONE_A 1 @CHECK_B
WAIT(1)
000A: @MAIN_WAIT
:CHECK_B
00D6: $DONE_B 1 @ALL_DONE
WAIT(1)
000A: @MAIN_WAIT
:ALL_DONE
TYPE_ASSERT($TOTAL, "i32", $TYPE_OK)
PRINT("TOTAL")
PRINT($TOTAL)
PRINT("TYPE_OK")
PRINT($TYPE_OK)
0001:

:WORKER_A
LET_I32(local_a, 40)
0006: $TOTAL $TOTAL local_a
END_THREAD()

:WORKER_B
LET_I32(local_b, 2)
0006: $TOTAL $TOTAL local_b
END_THREAD()
