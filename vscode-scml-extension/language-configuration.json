{
  "comments": {
    "lineComment": ";"
  },
  "brackets": [["{", "}"], ["[", "]"], ["(", ")"]],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] }
  ],
  "surroundingPairs": [["{", "}"], ["[", "]"], ["(", ")"], ["\"", "\""]],
  "wordPattern": "(@?[A-Za-z_][A-Za-z0-9_@.$-]*|[0-9A-Fa-f]{4})",
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(macro\\b.*:|:[A-Za-z_][A-Za-z0-9_]*\\b)",
    "decreaseIndentPattern": "^\\s*(endmacro|0001:)\\b"
  },
  "folding": { "markers": { "start": "^\\s*(:[A-Za-z_][A-Za-z0-9_]*|macro\\b)", "end": "^\\s*(0001:|endmacro)\\b" } }
}
