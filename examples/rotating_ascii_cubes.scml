; Pure SCML port of the exact three-cube C renderer from the prompt.
; No #include, no std macros, no console.cube_frame/native C renderer.
; SCML owns A/B/C, z-buffer, projection math and surface loops.  The
; framebuffer is a pinned byte span rendered by a VM intrinsic so ASCII output
; is a contiguous safe buffer operation instead of thousands of PRINT calls.

:MAIN
; printf("\x1b[2J");
0B32: "\033[2J"
0004: $A 0.0
0004: $B 0.0
0004: $C 0.0
0004: $WIDTH 160
0004: $HEIGHT 44
0004: $SIZE 7040
0004: $HALF_WIDTH 80.0
0004: $HALF_HEIGHT 22.0
0004: $DISTANCE_FROM_CAM 100.0
0004: $K1 40.0
0004: $INCREMENT 0.6
0004: $OOZ_SCALE 100000.0
0B43: $SIZE $BUFFER
0B44: $BUFFER
0B14: 7040 $ZBUF

:FRAME
; memset(buffer, '.', width * height); memset(zBuffer, 0, width * height)
0B45: $BUFFER 0 $SIZE 46
0B45: $ZBUF 0 $SIZE 0

:DRAW_ALL
0004: $CUBE_WIDTH 20.0
0007: $HORIZONTAL_OFFSET 0.0 40.0
0D00: @DRAW_CUBE
0004: $CUBE_WIDTH 10.0
0004: $HORIZONTAL_OFFSET 10.0
0D00: @DRAW_CUBE
0004: $CUBE_WIDTH 5.0
0004: $HORIZONTAL_OFFSET 40.0
0D00: @DRAW_CUBE
0D00: @PRINT_BUFFER

0006: $A $A 0.25
0006: $B $B 0.25
0006: $C $C 0.05
000B: 8
000A: @FRAME

:DRAW_CUBE
0007: $NEG_CUBE_WIDTH 0.0 $CUBE_WIDTH
0004: $CUBE_X $NEG_CUBE_WIDTH
:CUBE_X_CHECK
00D9: $CUBE_X $CUBE_WIDTH @CUBE_X_BODY
0D01:
:CUBE_X_BODY
0004: $CUBE_Y $NEG_CUBE_WIDTH
:CUBE_Y_CHECK
00D9: $CUBE_Y $CUBE_WIDTH @CUBE_Y_BODY
0006: $CUBE_X $CUBE_X $INCREMENT
000A: @CUBE_X_CHECK
:CUBE_Y_BODY

; calculateForSurface(cubeX, cubeY, -cubeWidth, '@')
0004: $P_I $CUBE_X
0004: $P_J $CUBE_Y
0004: $P_K $NEG_CUBE_WIDTH
0004: $CH_CODE 64
0D00: @PLOT_SURFACE

; calculateForSurface(cubeWidth, cubeY, cubeX, '$')
0004: $P_I $CUBE_WIDTH
0004: $P_J $CUBE_Y
0004: $P_K $CUBE_X
0004: $CH_CODE 36
0D00: @PLOT_SURFACE

; calculateForSurface(-cubeWidth, cubeY, -cubeX, '~')
0004: $P_I $NEG_CUBE_WIDTH
0004: $P_J $CUBE_Y
0007: $P_K 0.0 $CUBE_X
0004: $CH_CODE 126
0D00: @PLOT_SURFACE

; calculateForSurface(-cubeX, cubeY, cubeWidth, '#')
0007: $P_I 0.0 $CUBE_X
0004: $P_J $CUBE_Y
0004: $P_K $CUBE_WIDTH
0004: $CH_CODE 35
0D00: @PLOT_SURFACE

; calculateForSurface(cubeX, -cubeWidth, -cubeY, ';')
0004: $P_I $CUBE_X
0004: $P_J $NEG_CUBE_WIDTH
0007: $P_K 0.0 $CUBE_Y
0004: $CH_CODE 59
0D00: @PLOT_SURFACE

; calculateForSurface(cubeX, cubeWidth, cubeY, '+')
0004: $P_I $CUBE_X
0004: $P_J $CUBE_WIDTH
0004: $P_K $CUBE_Y
0004: $CH_CODE 43
0D00: @PLOT_SURFACE

0006: $CUBE_Y $CUBE_Y $INCREMENT
000A: @CUBE_Y_CHECK

:PLOT_SURFACE
; sin/cos cache for this point
0B34: $SIN_A $A
0B35: $COS_A $A
0B34: $SIN_B $B
0B35: $COS_B $B
0B34: $SIN_C $C
0B35: $COS_C $C

; X = j*sin(A)*sin(B)*cos(C) - k*cos(A)*sin(B)*cos(C) + j*cos(A)*sin(C) + k*sin(A)*sin(C) + i*cos(B)*cos(C)
0008: $T1 $P_J $SIN_A
0008: $T1 $T1 $SIN_B
0008: $T1 $T1 $COS_C
0008: $T2 $P_K $COS_A
0008: $T2 $T2 $SIN_B
0008: $T2 $T2 $COS_C
0007: $X3D $T1 $T2
0008: $T3 $P_J $COS_A
0008: $T3 $T3 $SIN_C
0006: $X3D $X3D $T3
0008: $T4 $P_K $SIN_A
0008: $T4 $T4 $SIN_C
0006: $X3D $X3D $T4
0008: $T5 $P_I $COS_B
0008: $T5 $T5 $COS_C
0006: $X3D $X3D $T5

; Y = j*cos(A)*cos(C) + k*sin(A)*cos(C) - j*sin(A)*sin(B)*sin(C) + k*cos(A)*sin(B)*sin(C) - i*cos(B)*sin(C)
0008: $T1 $P_J $COS_A
0008: $T1 $T1 $COS_C
0008: $T2 $P_K $SIN_A
0008: $T2 $T2 $COS_C
0006: $Y3D $T1 $T2
0008: $T3 $P_J $SIN_A
0008: $T3 $T3 $SIN_B
0008: $T3 $T3 $SIN_C
0007: $Y3D $Y3D $T3
0008: $T4 $P_K $COS_A
0008: $T4 $T4 $SIN_B
0008: $T4 $T4 $SIN_C
0006: $Y3D $Y3D $T4
0008: $T5 $P_I $COS_B
0008: $T5 $T5 $SIN_C
0007: $Y3D $Y3D $T5

; Z = k*cos(A)*cos(B) - j*sin(A)*cos(B) + i*sin(B) + distanceFromCam
0008: $T1 $P_K $COS_A
0008: $T1 $T1 $COS_B
0008: $T2 $P_J $SIN_A
0008: $T2 $T2 $COS_B
0007: $Z3D $T1 $T2
0008: $T3 $P_I $SIN_B
0006: $Z3D $Z3D $T3
0006: $Z3D $Z3D $DISTANCE_FROM_CAM

0009: $OOZ 1.0 $Z3D
0008: $PXF $K1 $OOZ
0008: $PXF $PXF $X3D
0008: $PXF $PXF 2.0
0006: $PXF $PXF $HALF_WIDTH
0006: $PXF $PXF $HORIZONTAL_OFFSET
0B23: $XP $PXF
0008: $PYF $K1 $OOZ
0008: $PYF $PYF $Y3D
0006: $PYF $PYF $HALF_HEIGHT
0B23: $YP $PYF
0008: $ROW $YP $WIDTH
0006: $IDX $XP $ROW

00D9: $IDX 0 @PLOT_END
00D8: $IDX $SIZE @PLOT_END
0008: $OOZI_F $OOZ $OOZ_SCALE
0B23: $OOZI $OOZI_F
0B12: $OLD_Z $ZBUF $IDX
00D8: $OOZI $OLD_Z @PLOT_WRITE
000A: @PLOT_END
:PLOT_WRITE
0B13: $ZBUF $IDX $OOZI
0B46: $BUFFER $IDX $CH_CODE
:PLOT_END
0D01:

:PRINT_BUFFER
0B48: $BUFFER $WIDTH $HEIGHT
0D01:
