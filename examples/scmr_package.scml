#include "../std.scmlh"

:MAIN
; Example: SCMR package metadata + robust startup checks.
PACKAGE_BEGIN(1001, 1, 0, 0)
TARGET_EXE()
PACKAGE_ENTRY(2001)
PACKAGE_RESOURCE_COUNT(2)
PACKAGE_RESOURCE_SLOT(0, 3001, 1, 4096)
PACKAGE_RESOURCE_SLOT(1, 3002, 2, 2048)

SET($status, SCML_OK)
SET($ready, TRUE)
REQUIRE_TRUE($ready, $status, SCML_ERR_STATE, @FAIL)
TRIGGER_EVENT("ON_START")
HALT()

:FAIL
TRIGGER_EVENT("ON_BOOT_FAIL")
HALT()
