; vm.scmlh - official std.vm module for execution metadata.
; Naming: lower_snake_case, no SCML_* global prefixes.
; Domain: runtime/vm. Depends on: VM metadata variables.
#pragma once

macro vm_trace_set(on_off) {
    0004: $SCML_VM_TRACE on_off
}

macro jit_hint(region_name) {
    0004: $SCML_JIT_HINT region_name
}

macro spaceship_cmp(out_cmp, a, b) {
    0007: out_cmp a b
}
