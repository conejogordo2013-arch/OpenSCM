; Pure SCML terminal loading circle.
; No #include, no std macros, no native frame generator: every pixel decision is SCML.

:MAIN
0B33:
0004: $TICK 0
0004: $WIDTH 21
0004: $HEIGHT 11
0004: $CX 10
0004: $CY 5
0004: $RADIUS 4.0
0004: $RING_MIN 11
0004: $RING_MAX 21

:FRAME
0B32: "\033[H"
0B32: "Cargando...\n\n"

; head = round(center + sin/cos(tick * 0.35) * radius)
0008: $ANGLE $TICK 0.35
0B35: $COS_A $ANGLE
0B34: $SIN_A $ANGLE
0008: $HEAD_XF $COS_A $RADIUS
0008: $HEAD_YF $SIN_A $RADIUS
0B3B: $HEAD_XF $HEAD_XF
0B3B: $HEAD_YF $HEAD_YF
0B23: $HEAD_XI $HEAD_XF
0B23: $HEAD_YI $HEAD_YF
0006: $HEAD_X $CX $HEAD_XI
0006: $HEAD_Y $CY $HEAD_YI

0004: $Y 0
:Y_CHECK
00D9: $Y $HEIGHT @Y_BODY
000A: @AFTER_FRAME

:Y_BODY
0004: $X 0
:X_CHECK
00D9: $X $WIDTH @X_BODY
0B32: "\n"
0006: $Y $Y 1
000A: @Y_CHECK

:X_BODY
00D7: $X $HEAD_X @NOT_HEAD
00D7: $Y $HEAD_Y @NOT_HEAD
0B32: "@"
000A: @NEXT_X

:NOT_HEAD
0007: $DX $X $CX
0007: $DY $Y $CY
0008: $DX2 $DX $DX
0008: $DY2 $DY $DY
0006: $D2 $DX2 $DY2
00D8: $D2 $RING_MIN @MAYBE_RING
0B32: " "
000A: @NEXT_X

:MAYBE_RING
00D9: $D2 $RING_MAX @DRAW_RING
0B32: " "
000A: @NEXT_X

:DRAW_RING
0B32: "."

:NEXT_X
0006: $X $X 1
000A: @X_CHECK

:AFTER_FRAME
0006: $TICK $TICK 1
000B: 16
000A: @FRAME
