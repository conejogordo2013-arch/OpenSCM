; STSCM - standard library wrappers built as macros over core SCML opcodes.
; The library keeps high-level names outside the VM core: every helper expands to an existing opcode.
macro PRINT(msg):
    03E5: msg
endmacro
macro LOG(msg):
    03E6: msg
endmacro
macro LOG_FILE(path, data):
    0A20: path data
endmacro
macro FILE_WRITE(path, data):
    0A20: path data
endmacro
macro FILE_APPEND(path, data):
    0A20: path data
endmacro
macro FILE_READ(path, outvar):
    0A10: path outvar
endmacro
macro WAIT(ms):
    000B: ms
endmacro
macro TIMER_SLEEP(ms):
    000B: ms
endmacro
macro ENTITY_SPAWN(model, x, y, z, outvar):
    0B00: model x y z outvar
endmacro
macro ENTITY_SET(entity, field, value):
    0B01: entity field value
endmacro
macro EVENT_BIND(name, label):
    0A30: name label
endmacro
macro EVENT_TRIGGER(name):
    0A31: name
endmacro
macro ALLOC(size, outvar):
    0B10: size outvar
endmacro
macro FREE(ref):
    0B11: ref
endmacro
macro READ(outvar, ref, index):
    0B12: outvar ref index
endmacro
macro WRITE(ref, index, value):
    0B13: ref index value
endmacro
macro ARRAY_CREATE(size, outvar):
    0B14: size outvar
endmacro
macro ARRAY_PUSH(ref, value):
    0B15: ref value
endmacro
macro ARRAY_POP(outvar, ref):
    0B16: outvar ref
endmacro
macro ARRAY_LEN(outvar, ref):
    0B17: outvar ref
endmacro
macro INT(outvar, value):
    0B18: outvar value
endmacro

macro INT2(outvar, value):
    0B19: outvar value
endmacro

macro INT4(outvar, value):
    0B1A: outvar value
endmacro

macro INT8(outvar, value):
    0B1B: outvar value
endmacro

macro INT16(outvar, value):
    0B1C: outvar value
endmacro

macro INT32(outvar, value):
    0B1D: outvar value
endmacro

macro INT64(outvar, value):
    0B1E: outvar value
endmacro

macro int(outvar, value):
    0B18: outvar value
endmacro

macro int2(outvar, value):
    0B19: outvar value
endmacro

macro int4(outvar, value):
    0B1A: outvar value
endmacro

macro int8(outvar, value):
    0B1B: outvar value
endmacro

macro int16(outvar, value):
    0B1C: outvar value
endmacro

macro int32(outvar, value):
    0B1D: outvar value
endmacro

macro int64(outvar, value):
    0B1E: outvar value
endmacro

macro TYPE_OF(outvar, value):
    0B1F: outvar value
endmacro

macro BOOL(outvar, value):
    0B20: outvar value
endmacro

macro NULL(outvar):
    0B21: outvar
endmacro

macro FLOAT32(outvar, value):
    0B2B: outvar value
endmacro

macro STRING(outvar, value):
    0B2C: outvar value
endmacro

macro IS_TYPE(outvar, value, type_name):
    0B2A: outvar value type_name
endmacro

macro CLASS_DEFINE(name, outvar):
    0B22: name outvar
endmacro

macro CLASS_EXTENDS(child, parent):
    0B23: child parent
endmacro

macro OBJECT_NEW(class_ref, outvar):
    0B24: class_ref outvar
endmacro

macro FIELD_SET(object_ref, field_name, value):
    0B25: object_ref field_name value
endmacro

macro FIELD_GET(outvar, object_ref, field_name):
    0B26: outvar object_ref field_name
endmacro

macro INSTANCE_OF(outvar, object_ref, class_ref):
    0B27: outvar object_ref class_ref
endmacro

macro CLASS_METHOD(class_ref, method_name, label):
    0B28: class_ref method_name label
endmacro

macro METHOD_CALL(object_ref, method_name):
    0B29: object_ref method_name
endmacro

macro METHOD_CALL1(object_ref, method_name, arg0):
    0B29: object_ref method_name arg0
endmacro

macro METHOD_CALL2(object_ref, method_name, arg0, arg1):
    0B29: object_ref method_name arg0 arg1
endmacro

macro type_of(outvar, value):
    0B1F: outvar value
endmacro

macro bool(outvar, value):
    0B20: outvar value
endmacro

macro null(outvar):
    0B21: outvar
endmacro

macro float32(outvar, value):
    0B2B: outvar value
endmacro

macro string(outvar, value):
    0B2C: outvar value
endmacro

macro is_type(outvar, value, type_name):
    0B2A: outvar value type_name
endmacro

macro class_define(name, outvar):
    0B22: name outvar
endmacro

macro class_extends(child, parent):
    0B23: child parent
endmacro

macro object_new(class_ref, outvar):
    0B24: class_ref outvar
endmacro

macro field_set(object_ref, field_name, value):
    0B25: object_ref field_name value
endmacro

macro field_get(outvar, object_ref, field_name):
    0B26: outvar object_ref field_name
endmacro

macro instance_of(outvar, object_ref, class_ref):
    0B27: outvar object_ref class_ref
endmacro

macro class_method(class_ref, method_name, label):
    0B28: class_ref method_name label
endmacro

macro method_call(object_ref, method_name):
    0B29: object_ref method_name
endmacro

macro method_call1(object_ref, method_name, arg0):
    0B29: object_ref method_name arg0
endmacro

macro method_call2(object_ref, method_name, arg0, arg1):
    0B29: object_ref method_name arg0 arg1
endmacro

macro MATH_ADD(outvar, a, b):
    0006: outvar a b
endmacro
macro MATH_SUB(outvar, a, b):
    0007: outvar a b
endmacro
macro MATH_MUL(outvar, a, b):
    0008: outvar a b
endmacro
macro MATH_DIV(outvar, a, b):
    0009: outvar a b
endmacro
