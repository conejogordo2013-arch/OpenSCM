; error_expected.scmlh - error_code, expected/outcome, stacktrace and contracts.
#pragma once

macro error_code_make(lhs_value, rhs_value, out_value) {
    0B31: "error.error_code_make" lhs_value rhs_value
    0004: out_value $RETVAL
}

