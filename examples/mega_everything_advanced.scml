use "mega_everything_advanced.scmlh";

:MAIN
MEGA_BOOTSTRAP("MEGA")

; --- OOP + RTTI + namespaces style object graph ---
NS_OBJECT_NEW(16, 0@)
NS_OBJECT_NEW(16, 1@)
NS_OBJECT_NEW(16, 2@)
NS_LINK_CHILD(0@, 0, 1@)
NS_LINK_CHILD(0@, 1, 2@)
NS_RTTI_SET(0@, SCML_RTTI_KIND_OBJECT)
NS_RTTI_SET(1@, SCML_RTTI_KIND_VECTOR)
NS_RTTI_SET(2@, SCML_RTTI_KIND_OPTIONAL)
NS_MEMBER_SET(1@, 0, 2026)
NS_MEMBER_SET(2@, 0, 99)
NS_MEMBER_GET_PATH2(3@, 0@, 0, 0)
NS_MEMBER_GET_PATH2(4@, 0@, 1, 0)
PRINT(3@)
PRINT(4@)

; --- Pointer + advanced math ---
PTR_NEW_STRUCT(3, 10@)
PTR_SET(10@, 0, 3)
PTR_SET(10@, 1, 4)
PTR_SET(10@, 2, 5)
MATH_POW2(11@, 12)
MATH_POW3(12@, 5)
MATH_LERP_I32(13@, 100, 300, 1, 4)
PRINT(11@)
PRINT(12@)
PRINT(13@)

; --- Complex ASCII frame build ---
MEGA_ASCII_ALLOC($BUF, $ZBUF)
0004: $I 0
:CLEAR
00D9: $I MEGA_ASCII_SIZE @CLEAR_BODY
000A: @DRAW
:CLEAR_BODY
0B13: $BUF $I 46
0B13: $ZBUF $I 0
0006: $I $I 1
000A: @CLEAR

:DRAW
0004: $X 0
:RASTER
00D9: $X 420 @PIXEL
000A: @PRINT_BUF
:PIXEL
0007: 20@ $X MEGA_ASCII_W
0008: 21@ 20@ MEGA_ASCII_H
0007: 22@ 21@ MEGA_ASCII_SIZE
0B13: $BUF 22@ 64
0006: 23@ 22@ 17
00D9: 23@ MEGA_ASCII_SIZE @P2
000A: @P2D
:P2
0B13: $BUF 23@ 35
:P2D
0006: 24@ 22@ 31
00D9: 24@ MEGA_ASCII_SIZE @P3
000A: @P3D
:P3
0B13: $BUF 24@ 43
:P3D
0006: $X $X 1
000A: @RASTER

:PRINT_BUF
03E5: "[MEGA ASCII]"
0004: $K 0
:PR
00D9: $K MEGA_ASCII_SIZE @PR_B
000A: @END
:PR_B
0B12: 30@ $BUF $K
03E5: 30@
0006: $K $K 1
000A: @PR

:END
MEGA_ASCII_FREE($BUF, $ZBUF)
PTR_FREE_SAFE(10@)
END_THREAD()

:FAIL
PRINT("MEGA_FAIL")
END_THREAD()
