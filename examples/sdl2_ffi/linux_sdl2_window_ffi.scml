; Linux SDL2 + SCML FFI: crear una ventana básica durante 2 segundos.
;
; Requisitos Ubuntu/Debian/Fedora/Arch equivalentes:
;   - SDL2 runtime instalado (por ejemplo libsdl2-2.0-0 o SDL2)
;   - OpenSCM construido con libffi (make bin/scml)
;
; Ejecutar desde la raíz del repo:
;   bin/scml compile examples/sdl2_ffi/linux_sdl2_window_ffi.scml .scml/linux_sdl2_window_ffi.scmlbin
;   bin/scml run .scml/linux_sdl2_window_ffi.scmlbin
;
; Nota: es un ejemplo mínimo de FFI directa. No implementa loop de eventos.

use "std.scmlh";

#define SDL_INIT_VIDEO 32
#define SDL_WINDOWPOS_CENTERED 805240832
#define SDL_WINDOW_SHOWN 4

:MAIN
; En Linux el soname normal de SDL2 es libSDL2-2.0.so.0.
0B31: "ffi.load" "libSDL2-2.0.so.0"

0B31: "ffi.declare" "SDL_Init" "int" "u32"
0B31: "ffi.declare" "SDL_CreateWindow" "pointer" "string,int,int,int,int,u32"
0B31: "ffi.declare" "SDL_Delay" "void" "u32"
0B31: "ffi.declare" "SDL_DestroyWindow" "void" "pointer"
0B31: "ffi.declare" "SDL_Quit" "void" ""

0B31: "SDL_Init" SDL_INIT_VIDEO
0B31: "SDL_CreateWindow" "SCML + SDL2 FFI (Linux)" SDL_WINDOWPOS_CENTERED SDL_WINDOWPOS_CENTERED 640 360 SDL_WINDOW_SHOWN
0004: $WINDOW $RETVAL

; Mantiene la ventana visible 2 segundos.
0B31: "SDL_Delay" 2000
0B31: "SDL_DestroyWindow" $WINDOW
0B31: "SDL_Quit"
0001:
