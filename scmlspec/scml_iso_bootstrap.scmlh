; SCML ISO bootstrap catalog (SCML-style naming only)
; This file intentionally maps broad language domains into SCML preprocessor symbols.
#define __scml 1

; --- translation/preprocess ---
#define SCML_PP_INCLUDE 1
#define SCML_PP_DEFINE 1
#define SCML_PP_UNDEF 1
#define SCML_PP_IF 1
#define SCML_PP_IFDEF 1
#define SCML_PP_IFNDEF 1
#define SCML_PP_ELIF 1
#define SCML_PP_ELSE 1
#define SCML_PP_ENDIF 1
#define SCML_PP_ERROR 1
#define SCML_PP_LINE 1
#define SCML_PP_PRAGMA 1
#define SCML_PP_STRINGIZE 1
#define SCML_PP_TOKEN_PASTE 1

; --- lexical domains ---
#define SCML_LEX_TOKENS 1
#define SCML_LEX_IDENTIFIERS 1
#define SCML_LEX_KEYWORDS 1
#define SCML_LEX_LITERALS 1
#define SCML_LEX_COMMENTS 1

; --- type categories ---
#define SCML_TYPE_VOID 1
#define SCML_TYPE_BOOL 1
#define SCML_TYPE_CHAR 1
#define SCML_TYPE_SIGNED_CHAR 1
#define SCML_TYPE_UNSIGNED_CHAR 1
#define SCML_TYPE_WCHAR_T 1
#define SCML_TYPE_CHAR8_T 1
#define SCML_TYPE_CHAR16_T 1
#define SCML_TYPE_CHAR32_T 1
#define SCML_TYPE_SHORT 1
#define SCML_TYPE_UNSIGNED_SHORT 1
#define SCML_TYPE_INT 1
#define SCML_TYPE_UNSIGNED_INT 1
#define SCML_TYPE_LONG 1
#define SCML_TYPE_UNSIGNED_LONG 1
#define SCML_TYPE_LONG_LONG 1
#define SCML_TYPE_UNSIGNED_LONG_LONG 1
#define SCML_TYPE_FLOAT 1
#define SCML_TYPE_DOUBLE 1
#define SCML_TYPE_LONG_DOUBLE 1
#define SCML_TYPE_NULLPTR_T 1

; --- semantic categories ---
#define SCML_VALUE_LVALUE 1
#define SCML_VALUE_XVALUE 1
#define SCML_VALUE_PRVALUE 1
#define SCML_VALUE_GLVALUE 1
#define SCML_VALUE_RVALUE 1

#define SCML_STORAGE_AUTOMATIC 1
#define SCML_STORAGE_STATIC 1
#define SCML_STORAGE_THREAD 1
#define SCML_STORAGE_DYNAMIC 1

#define SCML_LINKAGE_NONE 1
#define SCML_LINKAGE_INTERNAL 1
#define SCML_LINKAGE_EXTERNAL 1
#define SCML_LINKAGE_MODULE 1

; --- advanced domains ---
#define SCML_TEMPLATE_CORE 1
#define SCML_TEMPLATE_SFINAE 1
#define SCML_TEMPLATE_CTAD 1
#define SCML_TEMPLATE_PACKS 1
#define SCML_TEMPLATE_FOLD 1
#define SCML_TEMPLATE_CONCEPTS 1

#define SCML_COROUTINE_PROMISE 1
#define SCML_COROUTINE_AWAITER 1
#define SCML_COROUTINE_SUSPEND_POINT 1
#define SCML_COROUTINE_FRAME 1

#define SCML_MODULE_GLOBAL_FRAGMENT 1
#define SCML_MODULE_PRIVATE_FRAGMENT 1
#define SCML_MODULE_PARTITION 1
#define SCML_MODULE_EXPORT_DECL 1

#define SCML_MODEL_OBJECT_REPRESENTATION 1
#define SCML_MODEL_VALUE_REPRESENTATION 1
#define SCML_MODEL_STRICT_ALIASING 1
#define SCML_MODEL_LIFETIME 1
#define SCML_MODEL_ALIGNMENT 1

#define SCML_RULE_ODR 1
#define SCML_RULE_TEMPORARY_MATERIALIZATION 1
#define SCML_RULE_LIFETIME_EXTENSION 1
#define SCML_RULE_EVALUATION_ORDER 1
