; ffi.scmlh - official std.ffi module.
; Naming: lower_snake_case, no SCML_* global prefixes.
; Domain: external/ffi. Depends on: runtime FFI module.
#pragma once

macro ffi_null(out_ptr) {
    0B31: "ffi.null"
    0004: out_ptr $RETVAL
}

macro ffi_is_null(ptr_value, out_ok) {
    0B31: "ffi.is_null" ptr_value
    0004: out_ok $RETVAL
}

macro ffi_read_bytes(ptr_value, offset, size, out_hex) {
    0B31: "ffi.read_bytes" ptr_value offset size
    0004: out_hex $RETVAL
}

macro ffi_write_bytes(ptr_value, offset, hex_text, out_ok) {
    0B31: "ffi.write_bytes" ptr_value offset hex_text
    0004: out_ok $RETVAL
}

macro ffi_memcmp(lhs_ptr, rhs_ptr, size, out_cmp) {
    0B31: "ffi.memcmp" lhs_ptr rhs_ptr size
    0004: out_cmp $RETVAL
}

macro ffi_memmove(dst_ptr, src_ptr, size, out_ok) {
    0B31: "ffi.memmove" dst_ptr src_ptr size
    0004: out_ok $RETVAL
}

macro ffi_declare_abi(function_name, return_type, arg_types, abi_name, out_ok) {
    0B31: "ffi.declare_abi" function_name return_type arg_types abi_name
    0004: out_ok $RETVAL
}

macro ffi_bind(handle, alias_name, symbol_name, return_type, arg_types, abi_name, out_ok) {
    0B31: "ffi.bind" handle alias_name symbol_name return_type arg_types abi_name
    0004: out_ok $RETVAL
}

macro ffi_resolve(function_name, out_ptr) {
    0B31: "ffi.resolve" function_name
    0004: out_ptr $RETVAL
}


macro ffi_call_name(function_name, return_type, arg_types, out_value) {
    0B31: "ffi.call_name" function_name return_type arg_types
    0004: out_value $RETVAL
}

macro ffi_call_name1(function_name, return_type, arg_types, a0, out_value) {
    0B31: "ffi.call_name" function_name return_type arg_types a0
    0004: out_value $RETVAL
}

macro ffi_call_name2(function_name, return_type, arg_types, a0, a1, out_value) {
    0B31: "ffi.call_name" function_name return_type arg_types a0 a1
    0004: out_value $RETVAL
}
macro ffi_call_name3(function_name, return_type, arg_types, a0, a1, a2, out_value) {
    0B31: "ffi.call_name" function_name return_type arg_types a0 a1 a2
    0004: out_value $RETVAL
}

macro ffi_call_name4(function_name, return_type, arg_types, a0, a1, a2, a3, out_value) {
    0B31: "ffi.call_name" function_name return_type arg_types a0 a1 a2 a3
    0004: out_value $RETVAL
}

macro ffi_call_name5(function_name, return_type, arg_types, a0, a1, a2, a3, a4, out_value) {
    0B31: "ffi.call_name" function_name return_type arg_types a0 a1 a2 a3 a4
    0004: out_value $RETVAL
}

macro ffi_call_name6(function_name, return_type, arg_types, a0, a1, a2, a3, a4, a5, out_value) {
    0B31: "ffi.call_name" function_name return_type arg_types a0 a1 a2 a3 a4 a5
    0004: out_value $RETVAL
}

macro ffi_call_name7(function_name, return_type, arg_types, a0, a1, a2, a3, a4, a5, a6, out_value) {
    0B31: "ffi.call_name" function_name return_type arg_types a0 a1 a2 a3 a4 a5 a6
    0004: out_value $RETVAL
}

macro ffi_call_name8(function_name, return_type, arg_types, a0, a1, a2, a3, a4, a5, a6, a7, out_value) {
    0B31: "ffi.call_name" function_name return_type arg_types a0 a1 a2 a3 a4 a5 a6 a7
    0004: out_value $RETVAL
}

macro ffi_call_ptr(fn_ptr, return_type, arg_types, out_value) {
    0B31: "ffi.call_ptr" fn_ptr return_type arg_types
    0004: out_value $RETVAL
}

macro ffi_symbol_cache_count(out_count) {
    0B31: "ffi.stats"
    0004: out_count $RETVAL
}
