; Linux SDL2 + SCML FFI: crear una ventana real durante 2 segundos.
;
; Primero compila la librería nativa SDL2 del ejemplo:
;   examples/sdl2_ffi/build_linux.sh
;
; Luego ejecuta:
;   bin/scml run .scml/linux_sdl2_window_ffi.scmlbin
;
; Este script sí llama FFI real: carga libscml_sdl2_window.so y ejecuta una
; función C exportada que usa SDL_InitSubSystem + SDL_CreateWindow.

use "std.scmlh";

:MAIN
0B31: "ffi.load" "examples/sdl2_ffi/libscml_sdl2_window"
0B31: "ffi.declare" "scml_sdl2_open_window_ms" "int" "int,int,string,int"
0B31: "scml_sdl2_open_window_ms" 640 360 "SCML + SDL2 FFI (Linux)" 2000
PRINT($RETVAL)
0001:
