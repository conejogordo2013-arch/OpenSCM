macro STRCAT(outvar, a, b) {
    0B22: outvar a b
}

macro TO_INT(outvar, value) {
    0B23: outvar value
}

macro TO_FLOAT(outvar, value) {
    0B24: outvar value
}

macro IF_GE(a, b, label) {
    0B25: a b label
}

macro IF_LE(a, b, label) {
    0B26: a b label
}

macro SWITCH_I32(value, c1, l1, c2, l2, default_label) {
    IF_EQ(value, c1, l1)
    IF_EQ(value, c2, l2)
    JUMP(default_label)
}

; ==========================================================
; SCML BLOCK 1 — Systems Core (SCML-style, no C++ syntax)
; Primitive tags + explicit heap/reference/memory macros
; ==========================================================

#define SCML_T_INT 1
#define SCML_T_FLOAT 2
#define SCML_T_CHAR 3
#define SCML_T_BOOL 4
#define SCML_T_PTR 5

macro TYPE_INT(outvar, value) {
    0004: outvar value
}

macro TYPE_FLOAT(outvar, value) {
    0B24: outvar value
}

macro TYPE_CHAR(outvar, value) {
    0004: outvar value
}

macro TYPE_BOOL(outvar, value) {
    0004: outvar value
}

; Heap object layout:
; slot0 = type_tag
; slot1 = payload_0
; slot2 = payload_1 (optional / alignment-friendly extra slot)
macro NEW_TYPED(type_tag, payload0, outref) {
    ARRAY_CREATE(3, outref)
    HEAP_WRITE(outref, 0, type_tag)
    HEAP_WRITE(outref, 1, payload0)
    HEAP_WRITE(outref, 2, 0)
}

macro DELETE_TYPED(ref) {
    HEAP_FREE(ref)
}

macro PTR_NEW_INT(value, outref) {
    NEW_TYPED(SCML_T_INT, value, outref)
}

macro PTR_NEW_FLOAT(value, outref) {
    NEW_TYPED(SCML_T_FLOAT, value, outref)
}

macro PTR_LOAD(outvar, ref) {
    HEAP_READ(outvar, ref, 1)
}

macro PTR_STORE(ref, value) {
    HEAP_WRITE(ref, 1, value)
}

macro PTR_TYPEOF(out_type, ref) {
    HEAP_READ(out_type, ref, 0)
}

; Stack/local aliasing helpers (SCML frame-local variables)
macro REF_BIND(local_ref, target_ref) {
    0004: local_ref target_ref
}

macro CAST_INT(outvar, value) {
    0B23: outvar value
}

macro CAST_FLOAT(outvar, value) {
    0B24: outvar value
}

; ==========================================================
; SCML BLOCK 2 — Data Model (STRUCT / UNION / CLASS)
; SCML-native surface for OOP/data layout without C++ syntax
; ==========================================================

#define SCML_KIND_STRUCT 11
#define SCML_KIND_UNION 12
#define SCML_KIND_CLASS 13

; Common object header:
; slot0 = kind tag
; slot1 = field count
; slot2..N = payload fields
macro STRUCT_NEW(field_count, out_obj) {
    0006: 90@ field_count 2
    ARRAY_CREATE(90@, out_obj)
    HEAP_WRITE(out_obj, 0, SCML_KIND_STRUCT)
    HEAP_WRITE(out_obj, 1, field_count)
}

macro UNION_NEW(field_count, out_obj) {
    0006: 90@ field_count 2
    ARRAY_CREATE(90@, out_obj)
    HEAP_WRITE(out_obj, 0, SCML_KIND_UNION)
    HEAP_WRITE(out_obj, 1, field_count)
    HEAP_WRITE(out_obj, 2, 0)
}

macro CLASS_NEW(field_count, out_obj) {
    0006: 90@ field_count 2
    ARRAY_CREATE(90@, out_obj)
    HEAP_WRITE(out_obj, 0, SCML_KIND_CLASS)
    HEAP_WRITE(out_obj, 1, field_count)
}

macro OBJ_DELETE(obj_ref) {
    HEAP_FREE(obj_ref)
}

; Field access is zero-based logical index, mapped to heap slot +2
macro FIELD_SET(obj_ref, logical_index, value) {
    0006: 91@ logical_index 2
    HEAP_WRITE(obj_ref, 91@, value)
}

macro FIELD_GET(outvar, obj_ref, logical_index) {
    0006: 92@ logical_index 2
    HEAP_READ(outvar, obj_ref, 92@)
}

macro OBJ_KIND(out_kind, obj_ref) {
    HEAP_READ(out_kind, obj_ref, 0)
}

macro OBJ_FIELD_COUNT(out_count, obj_ref) {
    HEAP_READ(out_count, obj_ref, 1)
}

; UNION semantics: active tag lives in slot2, payload starts at slot3
macro UNION_SET_ACTIVE(union_ref, active_index) {
    HEAP_WRITE(union_ref, 2, active_index)
}

macro UNION_GET_ACTIVE(out_index, union_ref) {
    HEAP_READ(out_index, union_ref, 2)
}

macro UNION_SET_VALUE(union_ref, value) {
    HEAP_WRITE(union_ref, 3, value)
}

macro UNION_GET_VALUE(outvar, union_ref) {
    HEAP_READ(outvar, union_ref, 3)
}

; ==========================================================
; SCML BLOCK 3 — Generic + Compile-Time-style helpers
; AUTO / TYPEOF / constexpr-like SCML surface
; ==========================================================

#define SCML_META_UNSET -1

; Generic box layout:
; slot0 = type_tag
; slot1 = value
macro GEN_BOX_NEW(type_tag, value, out_box) {
    ARRAY_CREATE(2, out_box)
    HEAP_WRITE(out_box, 0, type_tag)
    HEAP_WRITE(out_box, 1, value)
}

macro GEN_BOX_GET(out_value, box_ref) {
    HEAP_READ(out_value, box_ref, 1)
}

macro GEN_BOX_TYPE(out_type, box_ref) {
    HEAP_READ(out_type, box_ref, 0)
}

; AUTO-style bind with explicit runtime tag
macro AUTO_BIND(type_tag, value, out_box) {
    GEN_BOX_NEW(type_tag, value, out_box)
}

; DECLTYPE-style read of boxed type metadata
macro DECLTYPE_BOX(out_type, box_ref) {
    GEN_BOX_TYPE(out_type, box_ref)
}

; constexpr-like compile/eval helpers (SCML macro-evaluated constants)
macro CONSTEXPR_I32(outvar, value) {
    0004: outvar value
}

macro CONSTEXPR_ADD(outvar, a, b) {
    0006: outvar a b
}

macro CONSTEXPR_SUB(outvar, a, b) {
    0007: outvar a b
}

macro CONSTEXPR_MUL(outvar, a, b) {
    0008: outvar a b
}

macro CONSTEXPR_DIV(outvar, a, b) {
    0009: outvar a b
}

; Generic transform over VECTOR-like heap array:
; out[i] = in[i] + addend
macro GEN_TRANSFORM_ADD(vec_ref, len, addend) {
    0004: 90@ 0
    :GEN_TRANSFORM_LOOP
    00D8: 90@ len @GEN_TRANSFORM_END
    HEAP_READ(91@, vec_ref, 90@)
    0006: 92@ 91@ addend
    HEAP_WRITE(vec_ref, 90@, 92@)
    0006: 90@ 90@ 1
    000A: @GEN_TRANSFORM_LOOP
    :GEN_TRANSFORM_END
}

; ==========================================================
; SCML BLOCK 4 — Exceptions + RTTI (SCML-style surface)
; TRY/CATCH-like status flow + runtime type tags
; ==========================================================

#define SCML_OK 0
#define SCML_ERR_GENERIC 1
#define SCML_ERR_TYPE 2

; TRY_BEGIN initializes status and jump labels are explicit in SCML style.
macro TRY_BEGIN(err_var) {
    0004: err_var SCML_OK
}

macro THROW(err_var, err_code) {
    0004: err_var err_code
}

macro CATCH_IF(err_var, err_code, label) {
    IF_EQ(err_var, err_code, label)
}

macro FINALLY_GOTO(label) {
    JUMP(label)
}

; RTTI helpers over objects created in Block 2:
; slot0 = kind tag (STRUCT/UNION/CLASS)
macro TYPE_INFO(out_kind, obj_ref) {
    HEAP_READ(out_kind, obj_ref, 0)
}

macro IS_A(obj_ref, expected_kind, out_bool) {
    TYPE_INFO(93@, obj_ref)
    0004: out_bool 0
    IF_EQ(93@, expected_kind, @IS_A_TRUE)
    JUMP(@IS_A_END)
    :IS_A_TRUE
    0004: out_bool 1
    :IS_A_END
}

macro CAST_SAFE(obj_ref, expected_kind, out_ref, err_var) {
    IS_A(obj_ref, expected_kind, 94@)
    IF_EQ(94@, 1, @CAST_SAFE_OK)
    THROW(err_var, SCML_ERR_TYPE)
    0004: out_ref 0
    JUMP(@CAST_SAFE_END)
    :CAST_SAFE_OK
    0004: out_ref obj_ref
    :CAST_SAFE_END
}

; ==========================================================
; SCML BLOCK 5 — Stdlib Core (STRING / VECTOR / MAP + algos)
; ==========================================================

; STRING: lightweight heap object
; slot0=type, slot1=length(meta), slot2=data(ref/value)
#define SCML_STD_STRING 21
macro STRING_NEW(value, out_str) {
    ARRAY_CREATE(3, out_str)
    HEAP_WRITE(out_str, 0, SCML_STD_STRING)
    HEAP_WRITE(out_str, 1, 0)
    HEAP_WRITE(out_str, 2, value)
}

macro STRING_SET(str_ref, value) {
    HEAP_WRITE(str_ref, 2, value)
}

macro STRING_GET(out_value, str_ref) {
    HEAP_READ(out_value, str_ref, 2)
}

; VECTOR: slot0=size, slot1=capacity, slot2..data
macro VECTOR_NEW(capacity, out_vec) {
    0006: 95@ capacity 2
    ARRAY_CREATE(95@, out_vec)
    HEAP_WRITE(out_vec, 0, 0)
    HEAP_WRITE(out_vec, 1, capacity)
}

macro VECTOR_SIZE(out_size, vec_ref) {
    HEAP_READ(out_size, vec_ref, 0)
}

macro VECTOR_PUSH(vec_ref, value) {
    HEAP_READ(96@, vec_ref, 0)
    0006: 97@ 96@ 2
    HEAP_WRITE(vec_ref, 97@, value)
    0006: 96@ 96@ 1
    HEAP_WRITE(vec_ref, 0, 96@)
}

macro VECTOR_GET(out_value, vec_ref, index) {
    0006: 98@ index 2
    HEAP_READ(out_value, vec_ref, 98@)
}

; MAP: key/value flat pairs in heap array
; slot0=count pairs, slot1=capacity pairs, then [k0,v0,k1,v1...]
macro MAP_NEW(capacity_pairs, out_map) {
    0008: 80@ capacity_pairs 2
    0006: 80@ 80@ 2
    ARRAY_CREATE(80@, out_map)
    HEAP_WRITE(out_map, 0, 0)
    HEAP_WRITE(out_map, 1, capacity_pairs)
}

macro MAP_PUT(map_ref, key, value) {
    HEAP_READ(81@, map_ref, 0)
    0008: 82@ 81@ 2
    0006: 82@ 82@ 2
    HEAP_WRITE(map_ref, 82@, key)
    0006: 83@ 82@ 1
    HEAP_WRITE(map_ref, 83@, value)
    0006: 81@ 81@ 1
    HEAP_WRITE(map_ref, 0, 81@)
}

macro MAP_GET_OR(out_value, map_ref, key, default_value) {
    0004: out_value default_value
    HEAP_READ(84@, map_ref, 0)
    0004: 85@ 0
    :MAP_GET_LOOP
    00D8: 85@ 84@ @MAP_GET_END
    0008: 86@ 85@ 2
    0006: 86@ 86@ 2
    HEAP_READ(87@, map_ref, 86@)
    IF_EQ(87@, key, @MAP_GET_HIT)
    0006: 85@ 85@ 1
    000A: @MAP_GET_LOOP
    :MAP_GET_HIT
    0006: 88@ 86@ 1
    HEAP_READ(out_value, map_ref, 88@)
    :MAP_GET_END
}

; Algorithms
macro ALG_FIND_EQ(out_index, vec_ref, len, needle) {
    0004: out_index -1
    0004: 70@ 0
    :ALG_FIND_LOOP
    00D8: 70@ len @ALG_FIND_END
    VECTOR_GET(71@, vec_ref, 70@)
    IF_EQ(71@, needle, @ALG_FIND_HIT)
    0006: 70@ 70@ 1
    000A: @ALG_FIND_LOOP
    :ALG_FIND_HIT
    0004: out_index 70@
    :ALG_FIND_END
}

macro ALG_SORT2_ASC(a_ref, b_ref) {
    IF_GT(a_ref, b_ref, @ALG_SWAP2)
    JUMP(@ALG_SWAP2_END)
    :ALG_SWAP2
    0004: 72@ a_ref
    0004: a_ref b_ref
    0004: b_ref 72@
    :ALG_SWAP2_END
}

; ==========================================================
; SCML BLOCK 6 — Modules / Link Surface / ABI-like contracts
; SCML-native symbol export/import conventions
; ==========================================================

; Module manifest slots:
; slot0 = module_id
; slot1 = version_major
; slot2 = version_minor
; slot3 = version_patch
; slot4 = export_count
macro MODULE_MANIFEST_NEW(module_id, vmaj, vmin, vpatch, out_manifest) {
    ARRAY_CREATE(5, out_manifest)
    HEAP_WRITE(out_manifest, 0, module_id)
    HEAP_WRITE(out_manifest, 1, vmaj)
    HEAP_WRITE(out_manifest, 2, vmin)
    HEAP_WRITE(out_manifest, 3, vpatch)
    HEAP_WRITE(out_manifest, 4, 0)
}

macro MODULE_EXPORT_COUNT_SET(manifest_ref, count) {
    HEAP_WRITE(manifest_ref, 4, count)
}

macro MODULE_EXPORT_COUNT_GET(out_count, manifest_ref) {
    HEAP_READ(out_count, manifest_ref, 4)
}

; Flat symbol table (key/value pairs): key=symbol_id, value=addr_or_ref
macro SYMBOL_TABLE_NEW(capacity_pairs, out_table) {
    MAP_NEW(capacity_pairs, out_table)
}

macro SYMBOL_EXPORT(table_ref, symbol_id, symbol_ref) {
    MAP_PUT(table_ref, symbol_id, symbol_ref)
}

macro SYMBOL_RESOLVE(out_ref, table_ref, symbol_id, default_ref) {
    MAP_GET_OR(out_ref, table_ref, symbol_id, default_ref)
}

; ABI contract box:
; slot0 = abi_id
; slot1 = call_conv
; slot2 = arg_count
; slot3 = ret_type_tag
macro ABI_CONTRACT_NEW(abi_id, call_conv, arg_count, ret_type_tag, out_contract) {
    ARRAY_CREATE(4, out_contract)
    HEAP_WRITE(out_contract, 0, abi_id)
    HEAP_WRITE(out_contract, 1, call_conv)
    HEAP_WRITE(out_contract, 2, arg_count)
    HEAP_WRITE(out_contract, 3, ret_type_tag)
}

macro ABI_ARGC_GET(out_argc, contract_ref) {
    HEAP_READ(out_argc, contract_ref, 2)
}

macro ABI_RET_GET(out_ret_type, contract_ref) {
    HEAP_READ(out_ret_type, contract_ref, 3)
}

macro MODULE_UNLOAD_SAFE(ref) {
    HEAP_FREE(ref)
}

; ===== Terminal rendering + complex string/math helpers =====
macro PRINT_RAW(v) {
    0B32: v
}

macro CONSOLE_CLEAR() {
    0B33:
}

macro CONSOLE_WRITE(v) {
    0B31: "console.write" v
}

macro CONSOLE_FLUSH() {
    0B31: "console.flush"
}

macro CONSOLE_HOME() {
    0B31: "console.home"
}

macro CONSOLE_COLOR(fg) {
    0B3E: fg
}

macro CONSOLE_COLOR_BG(fg, bg) {
    0B3E: fg bg
}

macro CONSOLE_RESET() {
    0B3F:
}

macro CONSOLE_MOVE(row, col) {
    0B40: row col
}

macro CONSOLE_ERASE_LINE() {
    0B41:
}

macro CONSOLE_STYLE(style) {
    0B42: style
}

macro SIN(outvar, radians) {
    0B34: outvar radians
}

macro COS(outvar, radians) {
    0B35: outvar radians
}

macro TAN(outvar, radians) {
    0B36: outvar radians
}

macro SQRT(outvar, value) {
    0B37: outvar value
}

macro ATAN2(outvar, y, x) {
    0B38: outvar y x
}

macro FLOOR(outvar, value) {
    0B39: outvar value
}

macro CEIL(outvar, value) {
    0B3A: outvar value
}

macro ROUND(outvar, value) {
    0B3B: outvar value
}

macro ABS(outvar, value) {
    0B3C: outvar value
}

macro STR_REPEAT(outvar, text, count) {
    0B3D: outvar text count
}

; ===== Hostless + async + static typing tier =====
; Built-in module wrappers make larger standalone scripts usable without a custom host.
macro APP_SLEEP_MS(ms) {
    CALL_NATIVE("runtime.wait", ms)
}
macro APP_TIME_MS() {
    CALL_NATIVE("runtime.get_time_ms", 0)
}
macro APP_READ_TEXT(path) {
    CALL_NATIVE("file.read_txt", path)
}
macro APP_WRITE_TEXT(path, data) {
    CALL_NATIVE3("file.write_txt", path, data, 0)
}
macro APP_CONSOLE_WRITE(text) {
    CALL_NATIVE("console.write", text)
}
macro APP_CONSOLE_FLUSH() {
    CALL_NATIVE("console.flush", 0)
}

; Cooperative async tasks run on the VM event queue. Labels spawned this way should
; finish with the thread-ending opcode so the task status flips to done.
macro ASYNC_SPAWN(label, out_task) {
    0B49: label out_task
}
macro ASYNC_DONE(task_ref, out_done) {
    0B4A: task_ref out_done
}
macro ASYNC_AWAIT_POLL(task_ref, done_label, pending_label) {
    0B4A: task_ref 26@
    00D6: 26@ 1 done_label
    000A: pending_label
}
macro ASYNC_YIELD_MS(ms) {
    000B: ms
}

; Compile-time checked declarations. The compiler validates assignments and numeric
; operations for i32/f32/str/any plus aliases such as bool, u32, i64, f64, ref,
; array<T>, vec<T>, option<T>, and result<T>. The VM also exposes runtime assertions.
macro TYPE_DECL(var_ref, type_name) {
    0B4B: var_ref type_name
}
macro LET_I32(var_ref, value) {
    0B4B: var_ref "i32"
    0004: var_ref value
}
macro LET_F32(var_ref, value) {
    0B4B: var_ref "f32"
    0004: var_ref value
}
macro LET_STR(var_ref, value) {
    0B4B: var_ref "str"
    0004: var_ref value
}
macro LET_ANY(var_ref, value) {
    0B4B: var_ref "any"
    0004: var_ref value
}
macro TYPE_ASSERT(value, type_name, out_ok) {
    0B4C: value type_name out_ok
}

; Rich type aliases for large codebases. The compiler canonicalizes these to the
; current VM runtime families while preserving readable source contracts.
macro LET_BOOL(var_ref, value) {
    0B4B: var_ref "bool"
    0004: var_ref value
}
macro LET_I64(var_ref, value) {
    0B4B: var_ref "i64"
    0004: var_ref value
}
macro LET_U32(var_ref, value) {
    0B4B: var_ref "u32"
    0004: var_ref value
}
macro LET_F64(var_ref, value) {
    0B4B: var_ref "f64"
    0004: var_ref value
}
macro LET_REF(var_ref, value) {
    0B4B: var_ref "ref"
    0004: var_ref value
}
macro LET_ARRAY(var_ref, value) {
    0B4B: var_ref "array<any>"
    0004: var_ref value
}

; Host-backed OS thread helpers. THREAD_CREATE_SLEEP starts a real native worker
; that completes after the given delay; THREAD_DONE polls it and THREAD_JOIN waits.
macro THREAD_CREATE_SLEEP(ms, out_thread) {
    0B31: "thread.create" ms
    0004: out_thread $RETVAL
}
macro THREAD_DONE(thread_ref, out_done) {
    0B31: "thread.done" thread_ref
    0004: out_done $RETVAL
}
macro THREAD_JOIN(thread_ref) {
    0B31: "thread.join" thread_ref
}
macro THREAD_YIELD() {
    0B31: "thread.yield" 0
}

; Modern std aliases: readable lower-case helpers intended for C/C#/SCML surface code.
; They expand to the same legacy opcodes/macros, so legacy and modern code can mix freely.
macro set(var_ref, value) {
    0004: var_ref value
}
macro add(outvar, a, b) {
    0006: outvar a b
}
macro sub(outvar, a, b) {
    0007: outvar a b
}
macro mul(outvar, a, b) {
    0008: outvar a b
}
macro div(outvar, a, b) {
    0009: outvar a b
}
macro array_new(outvar, size) {
    0B14: size outvar
}
macro array_get(outvar, ref, index) {
    0B12: outvar ref index
}
macro array_set(ref, index, value) {
    0B13: ref index value
}
macro array_len(outvar, ref) {
    0B30: outvar ref
}
macro type_decl(var_ref, type_name) {
    0B4B: var_ref type_name
}
macro type_assert(value, type_name, out_ok) {
    0B4C: value type_name out_ok
}
macro async_spawn(label, out_task) {
    0B49: label out_task
}
macro async_done(task_ref, out_done) {
    0B4A: task_ref out_done
}
macro thread_create_sleep(ms, out_thread) {
    0B31: "thread.create" ms
    0004: out_thread $RETVAL
}
macro thread_done(thread_ref, out_done) {
    0B31: "thread.done" thread_ref
    0004: out_done $RETVAL
}
macro thread_join(thread_ref) {
    0B31: "thread.join" thread_ref
}
macro heap_free(ref) {
    0B11: ref
}
macro vector_new(out_vec, capacity) {
    0006: 95@ capacity 2
    0B14: 95@ out_vec
    0B13: out_vec 0 0
    0B13: out_vec 1 capacity
}
macro vector_push(vec_ref, value) {
    0B12: 96@ vec_ref 0
    0006: 97@ 96@ 2
    0B13: vec_ref 97@ value
    0006: 96@ 96@ 1
    0B13: vec_ref 0 96@
}
macro vector_get(out_value, vec_ref, index) {
    0006: 98@ index 2
    0B12: out_value vec_ref 98@
}
macro vector_size(out_size, vec_ref) {
    0B12: out_size vec_ref 0
}
macro VECTOR_POP(out_value, vec_ref) {
    0B12: 96@ vec_ref 0
    0007: 96@ 96@ 1
    0B13: vec_ref 0 96@
    0006: 97@ 96@ 2
    0B12: out_value vec_ref 97@
}

macro ARRAY_PUSH(vec_ref, value) {
    vector_push(vec_ref, value)
}
macro ARRAY_POP(out_value, vec_ref) {
    VECTOR_POP(out_value, vec_ref)
}
macro vector_pop(out_value, vec_ref) {
    0B12: 96@ vec_ref 0
    0007: 96@ 96@ 1
    0B13: vec_ref 0 96@
    0006: 97@ 96@ 2
    0B12: out_value vec_ref 97@
}

; -----------------------------------------------------------------------------
; Advanced SCML surface helpers
; -----------------------------------------------------------------------------
; These helpers make the modern SCML surface feel closer to C++/C#/STL while
; still lowering to the existing VM opcodes. They are intentionally small,
; predictable wrappers: large libraries can be layered on top without expanding
; the core runtime.

#define nullptr 0
#define NULLPTR 0
#define null 0
#define TRUE 1
#define FALSE 0

macro SCML_COUT(value) {
    03E5: value
}
macro SCML_CIN(prompt, out_value) {
    0B21: prompt out_value
}

macro SCML_VECTOR_NEW(capacity, out_vec) {
    vector_new(out_vec, capacity)
}
macro SCML_VECTOR_PUSH(vec_ref, value) {
    vector_push(vec_ref, value)
}
macro SCML_VECTOR_GET(out_value, vec_ref, index) {
    vector_get(out_value, vec_ref, index)
}
macro SCML_VECTOR_SIZE(out_size, vec_ref) {
    vector_size(out_size, vec_ref)
}
macro SCML_LIST_NEW(capacity, out_list) {
    vector_new(out_list, capacity)
}
macro SCML_LIST_PUSH(list_ref, value) {
    vector_push(list_ref, value)
}
macro SCML_STRING_SET(out_string, value) {
    0B4B: out_string "str"
    0004: out_string value
}
macro SCML_MAP_NEW(out_map) {
    MAP_T_NEW("any", "any", 32, out_map)
}
macro SCML_MAP_PUT(map_ref, key, value) {
    MAP_T_PUT_I32(map_ref, key, value)
}
macro SCML_UNORDERED_MAP_NEW(out_map) {
    MAP_T_NEW("hash<any>", "any", 32, out_map)
}

macro SCML_OPTIONAL_SOME(value, out_optional) {
    OPTIONAL_T_SOME("any", value, out_optional)
}
macro SCML_OPTIONAL_NONE(out_optional) {
    OPTIONAL_T_NONE("any", out_optional)
}
macro SCML_OPTIONAL_UNWRAP(out_value, optional_ref, fallback_label) {
    OPTIONAL_T_UNWRAP("any", out_value, optional_ref, fallback_label)
}
macro SCML_EXPECTED_OK(value, out_expected) {
    0B14: 2 out_expected
    0B13: out_expected 0 1
    0B13: out_expected 1 value
}
macro SCML_EXPECTED_ERR(value, out_expected) {
    0B14: 2 out_expected
    0B13: out_expected 0 0
    0B13: out_expected 1 value
}
macro SCML_VARIANT_SET(out_variant, tag, value) {
    0B14: 2 out_variant
    0B13: out_variant 0 tag
    0B13: out_variant 1 value
}
macro SCML_ANY_SET(out_any, value) {
    0B4B: out_any "any"
    0004: out_any value
}

macro SCML_FILESYS_PATH_SET(out_path, value) {
    0B4B: out_path "str"
    0004: out_path value
}
macro SCML_FILESYS_EXISTS(path_value, out_exists) {
    0004: out_exists 0
}

macro SCML_REF_BIND(out_ref, value) {
    0B4B: out_ref "any"
    0004: out_ref value
}
macro SCML_CONST_BIND(out_const, value) {
    0B4B: out_const "any"
    0004: out_const value
}
macro SCML_MOVE(out_value, value) {
    0B4B: out_value "any"
    0004: out_value value
}
macro SCML_SMART_PTR_NEW(value, out_ptr) {
    0B14: 2 out_ptr
    0B13: out_ptr 0 1
    0B13: out_ptr 1 value
}

macro SCML_REFLECT_TYPE(value, out_type) {
    0004: out_type "any"
}
macro SCML_REFLECT_NAME(value, out_name) {
    0004: out_name "value"
}
macro SCML_RTTI_TAG(value, type_name) {
    RTTI_TAG_SET(value, type_name)
}

macro SCML_CONCEPT_ASSERT(value, type_name, out_ok) {
    TYPE_ASSERT(value, type_name, out_ok)
}
macro SCML_CONSTEXPR_ADD(out_value, a, b) {
    CONSTEXPR_ADD(out_value, a, b)
}
macro SCML_LAMBDA_STUB(out_lambda) {
    0B4B: out_lambda "any"
    0004: out_lambda 0
}

macro SCML_THREAD_SLEEP(ms, out_thread) {
    THREAD_CREATE_SLEEP(ms, out_thread)
}
macro SCML_THREAD_DONE(thread_ref, out_done) {
    THREAD_DONE(thread_ref, out_done)
}
macro SCML_THREAD_JOIN(thread_ref) {
    THREAD_JOIN(thread_ref)
}

macro SCML_RANGE_I32(begin_value, end_value, out_range) {
    0B14: 2 out_range
    0B13: out_range 0 begin_value
    0B13: out_range 1 end_value
}
macro SCML_RANGE_BEGIN(out_begin, range_ref) {
    0B12: out_begin range_ref 0
}
macro SCML_RANGE_END(out_end, range_ref) {
    0B12: out_end range_ref 1
}
macro SCML_SPACESHIP_CMP(out_cmp, a, b) {
    0007: out_cmp a b
}

macro SCML_MODULE_EXPORT(name, value) {
    0004: $SCML_MODULE_LAST_EXPORT name
    0004: $SCML_MODULE_LAST_VALUE value
}
macro SCML_VM_TRACE(on_off) {
    0004: $SCML_VM_TRACE on_off
}
macro SCML_JIT_HINT(region_name) {
    0004: $SCML_JIT_HINT region_name
}
