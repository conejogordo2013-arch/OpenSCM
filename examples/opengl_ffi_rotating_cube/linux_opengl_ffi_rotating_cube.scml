0B31: "ffi.call_name" "glMatrixMode" "void" "uint32" 5888
0B31: "ffi.call_name" "glLoadIdentity" "void" ""
0B31: "ffi.call_name" "glTranslatef" "void" "float,float,float" 0.0 0.0 -6.0
0B31: "ffi.call_name" "glRotatef" "void" "float,float,float,float" $ANGLE 0.7 1.0 0.25

0D00: @DRAW_CUBE

0B31: "ffi.call_name" "glfwSwapBuffers" "void" "pointer" $WINDOW
0B31: "ffi.call_name" "glfwPollEvents" "void" ""
0006: $ANGLE $ANGLE 1.25
000B: 1
000A: @FRAME

:DRAW_CUBE
