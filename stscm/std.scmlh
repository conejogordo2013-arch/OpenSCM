; std.scmlh - advanced general-purpose SCML standard library.
; This file intentionally contains no GTA/game-specific behavior.

#include "stscm.scml"
#include "scm_flow.scmlh"

#define TRUE 1
#define FALSE 0
#define NULL 0

; Common error/status model.
#define SCML_OK 0
#define SCML_ERR_GENERIC 1
#define SCML_ERR_INVALID_ARG 2
#define SCML_ERR_OUT_OF_RANGE 3
#define SCML_ERR_NOT_FOUND 4
#define SCML_ERR_NO_MEMORY 5
#define SCML_ERR_IO 6
#define SCML_ERR_STATE 7
#define SCML_ERR_UNSUPPORTED 8
#define SCML_ERR_ABORTED 9

; Artifact kinds (host/tooling can inspect these constants).
#define SCML_ARTIFACT_EXE 1
#define SCML_ARTIFACT_DLL 2
#define SCML_ARTIFACT_SO 3
#define SCML_ARTIFACT_VM_LIB 4
#define SCML_ARTIFACT_STD_LIB 5
#define SCML_ARTIFACT_ABI_LIB 6
#define SCML_PACKAGE_SCMR 100

; ---- Core VM / opcode aliases ----
macro NOP():
    0000:
endmacro

macro HALT():
    0001:
endmacro

macro SET(var, value):
    0004: var value
endmacro

macro STORE(var, value):
    0004: var value
endmacro

macro PUSH_INT(value):
    0002: value
endmacro

macro PUSH_STR(value):
    0003: value
endmacro

macro LOAD(value):
    0005: value
endmacro

macro ADD(outvar, a, b):
    0006: outvar a b
endmacro

macro SUB(outvar, a, b):
    0007: outvar a b
endmacro

macro MUL(outvar, a, b):
    0008: outvar a b
endmacro

macro DIV(outvar, a, b):
    0009: outvar a b
endmacro

macro JUMP(label):
    000A: label
endmacro

macro IF_EQ(a, b, label):
    00D6: a b label
endmacro

macro IF_NE(a, b, label):
    00D7: a b label
endmacro

macro IF_GT(a, b, label):
    00D8: a b label
endmacro

macro IF_LT(a, b, label):
    00D9: a b label
endmacro

; Lowercase aliases.
macro set(var, value):
    0004: var value
endmacro

macro add(outvar, a, b):
    0006: outvar a b
endmacro

macro sub(outvar, a, b):
    0007: outvar a b
endmacro

macro mul(outvar, a, b):
    0008: outvar a b
endmacro

macro div(outvar, a, b):
    0009: outvar a b
endmacro

; ---- Rich flow helpers ----
macro IF_ELSE_EQ(a, b, true_label, false_label):
    00D6: a b true_label
    000A: false_label
endmacro

macro IF_ELSE_NE(a, b, true_label, false_label):
    00D7: a b true_label
    000A: false_label
endmacro

macro IF_ELSE_GT(a, b, true_label, false_label):
    00D8: a b true_label
    000A: false_label
endmacro

macro IF_ELSE_LT(a, b, true_label, false_label):
    00D9: a b true_label
    000A: false_label
endmacro

macro ASSERT_EQ(a, b, fail_label):
    00D6: a b @ASSERT_OK
    000A: fail_label
    :ASSERT_OK
endmacro

macro ASSERT_NE(a, b, fail_label):
    00D7: a b @ASSERT_OK
    000A: fail_label
    :ASSERT_OK
endmacro

macro ASSERT_TRUE(v, fail_label):
    00D7: v FALSE @ASSERT_OK
    000A: fail_label
    :ASSERT_OK
endmacro

macro ASSERT_FALSE(v, fail_label):
    00D6: v FALSE @ASSERT_OK
    000A: fail_label
    :ASSERT_OK
endmacro

; ---- Memory aliases ----
macro HEAP_ALLOC(size, outvar):
    0B10: size outvar
endmacro

macro HEAP_FREE(ref):
    0B11: ref
endmacro

macro HEAP_READ(outvar, ref, index):
    0B12: outvar ref index
endmacro

macro HEAP_WRITE(ref, index, value):
    0B13: ref index value
endmacro

macro ARRAY_NEW(size, outvar):
    0B14: size outvar
endmacro

macro ARRAY_GET(outvar, ref, index):
    0B12: outvar ref index
endmacro

macro ARRAY_SET(ref, index, value):
    0B13: ref index value
endmacro

macro ARRAY_SAFE_GET(outvar, ref, index, len, status_var, fail_label):
    00D9: index len @ARRAY_SAFE_GET_OK
    0004: status_var SCML_ERR_OUT_OF_RANGE
    000A: fail_label
    :ARRAY_SAFE_GET_OK
    0B12: outvar ref index
    0004: status_var SCML_OK
endmacro

; ---- Error model helpers ----
macro STATUS_SET_OK(status_var):
    0004: status_var SCML_OK
endmacro

macro STATUS_SET_ERR(status_var, err):
    0004: status_var err
endmacro

macro RETURN_IF_ERR(status_var, err_label):
    00D7: status_var SCML_OK err_label
endmacro

macro REQUIRE_TRUE(cond_var, status_var, err_code, fail_label):
    00D7: cond_var FALSE @REQ_TRUE_OK
    0004: status_var err_code
    000A: fail_label
    :REQ_TRUE_OK
endmacro

; ---- Package/build metadata markers (.scmr style manifest via constants) ----
; These macros emit no runtime side effects by themselves; they are declarative
; assignments that host toolchains can parse from globals.
macro PACKAGE_BEGIN(name_id, version_major, version_minor, version_patch):
    0004: $SCMR_NAME_ID name_id
    0004: $SCMR_VER_MAJOR version_major
    0004: $SCMR_VER_MINOR version_minor
    0004: $SCMR_VER_PATCH version_patch
    0004: $SCMR_FORMAT SCML_PACKAGE_SCMR
endmacro

macro PACKAGE_ARTIFACT(kind, flags):
    0004: $SCMR_ARTIFACT_KIND kind
    0004: $SCMR_ARTIFACT_FLAGS flags
endmacro

macro PACKAGE_ENTRY(label_id):
    0004: $SCMR_ENTRY label_id
endmacro

macro PACKAGE_RESOURCE_COUNT(count):
    0004: $SCMR_RESOURCE_COUNT count
endmacro

macro PACKAGE_RESOURCE_SLOT(slot, id, type, size):
    0004: $SCMR_RES_SLOT slot
    0004: $SCMR_RES_ID id
    0004: $SCMR_RES_TYPE type
    0004: $SCMR_RES_SIZE size
endmacro

macro TARGET_EXE():
    0004: $SCMR_ARTIFACT_KIND SCML_ARTIFACT_EXE
    0004: $SCMR_ARTIFACT_FLAGS 0
endmacro

macro TARGET_DLL():
    0004: $SCMR_ARTIFACT_KIND SCML_ARTIFACT_DLL
    0004: $SCMR_ARTIFACT_FLAGS 0
endmacro

macro TARGET_SO():
    0004: $SCMR_ARTIFACT_KIND SCML_ARTIFACT_SO
    0004: $SCMR_ARTIFACT_FLAGS 0
endmacro

macro TARGET_SCMLVM_LIB():
    0004: $SCMR_ARTIFACT_KIND SCML_ARTIFACT_VM_LIB
    0004: $SCMR_ARTIFACT_FLAGS 0
endmacro

macro TARGET_SCMLSTD_LIB():
    0004: $SCMR_ARTIFACT_KIND SCML_ARTIFACT_STD_LIB
    0004: $SCMR_ARTIFACT_FLAGS 0
endmacro

macro TARGET_SCMLABI_LIB():
    0004: $SCMR_ARTIFACT_KIND SCML_ARTIFACT_ABI_LIB
    0004: $SCMR_ARTIFACT_FLAGS 0
endmacro

; ---- Event aliases ----
macro BIND_EVENT(name, label):
    0A30: name label
endmacro

macro TRIGGER_EVENT(name):
    0A31: name
endmacro
