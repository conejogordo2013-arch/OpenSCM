; memory_plus.scmlh - smart pointers, PMR, alignment and memory algorithms.
#pragma once

macro unique_ptr_make(lhs_value, rhs_value, out_value) {
    0B31: "memory.unique_ptr_make" lhs_value rhs_value
    0004: out_value $RETVAL
}

