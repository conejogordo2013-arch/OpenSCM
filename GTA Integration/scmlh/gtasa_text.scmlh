; GTA text, HUD, and radar wrappers.

macro PRINT_NOW(text, time_ms) {
    CALL "GTA_PrintNow" text time_ms
}

macro PRINT_BIG(text, time_ms, style) {
    CALL "GTA_PrintBig" text time_ms style
}

macro CLEAR_HELP() {
    CALL "GTA_ClearHelp"
}

macro DISPLAY_RADAR(enabled) {
    CALL "GTA_DisplayRadar" enabled
}

macro ADD_BLIP_FOR_COORD(x, y, z, outvar) {
    CALL "GTA_AddBlipForCoord" x y z
    0004: outvar $RETVAL
}

macro REMOVE_BLIP(blip) {
    CALL "GTA_RemoveBlip" blip
}
