{
  "name": "scml-advanced-tools",
  "displayName": "SCML Advanced Tools",
  "description": "Mature SCML IDE support: syntax highlighting, snippets, diagnostics, completions, hovers, definitions, symbols, formatting, rename, quick fixes, and compile/run commands.",
  "version": "0.1.0",
  "publisher": "openscm",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "activationEvents": [
    "onLanguage:scml",
    "onLanguage:scmlh",
    "onCommand:scml.compile",
    "onCommand:scml.run",
    "onCommand:scml.compileAndRun",
    "onCommand:scml.restartLanguageServices"
  ],
  "main": "./extension.js",
  "contributes": {
    "languages": [
      {
        "id": "scml",
        "aliases": [
          "SCML",
          "scml"
        ],
        "extensions": [
          ".scml",
          ".scmlh"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "scml",
        "scopeName": "source.scml",
        "path": "./syntaxes/scml.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "scml",
        "path": "./snippets/scml.json"
      }
    ],
    "commands": [
      {
        "command": "scml.compile",
        "title": "SCML: Compile Current File"
      },
      {
        "command": "scml.run",
        "title": "SCML: Run Current Binary"
      },
      {
        "command": "scml.compileAndRun",
        "title": "SCML: Compile and Run Current File"
      },
      {
        "command": "scml.restartLanguageServices",
        "title": "SCML: Restart Language Services"
      }
    ],
    "configuration": {
      "title": "SCML",
      "properties": {
        "scml.executablePath": {
          "type": "string",
          "default": "",
          "description": "Absolute path to SCML executable. If empty, extension searches bin/scml, scml.exe, then PATH."
        },
        "scml.defaultBinOutputDir": {
          "type": "string",
          "default": "${workspaceFolder}/bin",
          "description": "Default output directory for generated .scmlbin files."
        },
        "scml.runWithTrace": {
          "type": "boolean",
          "default": false,
          "description": "Include --trace when running SCML binaries."
        },
        "scml.diagnostics.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable SCML language-service diagnostics for labels, includes, opcodes, macros, and compiler errors."
        },
        "scml.diagnostics.compileOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Run the SCML compiler on saved .scml files and surface compiler errors in Problems."
        }
      }
    }
  }
}
