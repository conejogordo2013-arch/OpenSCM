#include "../std.scmlh"

; Port SCML del cargador C++ proporcionado: 21x11, centro (10,5), radio 4, 12 puntos.
; El ángulo se integra a 60 FPS con paso fijo equivalente a speed=5.0f y frameTime=16ms.
:MAIN
0004: $ANGLE2_FIXED 0
0004: $HEAD 0

:LOOP
0009: $HEAD $ANGLE2_FIXED 100
0B20: $HEAD $HEAD 12
00D6: $HEAD 0 @FRAME_0
00D6: $HEAD 1 @FRAME_1
00D6: $HEAD 2 @FRAME_2
00D6: $HEAD 3 @FRAME_3
00D6: $HEAD 4 @FRAME_4
00D6: $HEAD 5 @FRAME_5
00D6: $HEAD 6 @FRAME_6
00D6: $HEAD 7 @FRAME_7
00D6: $HEAD 8 @FRAME_8
00D6: $HEAD 9 @FRAME_9
00D6: $HEAD 10 @FRAME_10
00D6: $HEAD 11 @FRAME_11
000A: @FRAME_0

:FRAME_0
0B31: "console.write" "\033[2J\033[HCargando...\n\n                     \n          .          \n        .   .        \n             .       \n                     \n              .      \n                     \n                     \n                     \n                     \n                     \n"
000A: @AFTER_DRAW

