use "../stscm/std.scmlh";

:MAIN
; Block 2 demo (SCML data model style)
; STRUCT / UNION / CLASS without C++ syntax

0B14: 5 $S_PLAYER
0B13: $S_PLAYER 0 SCML_KIND_STRUCT
0B13: $S_PLAYER 1 3
0B13: $S_PLAYER 2 100
0B13: $S_PLAYER 3 25
0B13: $S_PLAYER 4 7
0B12: $HP $S_PLAYER 2
03E5: "STRUCT hp:"
03E5: $HP
0B12: $K0 $S_PLAYER 0
03E5: "STRUCT kind:"
03E5: $K0

0B14: 4 $U_ANY
0B13: $U_ANY 0 SCML_KIND_UNION
0B13: $U_ANY 1 2
0B13: $U_ANY 2 1
0B13: $U_ANY 3 999
0B12: $UA $U_ANY 2
0B12: $UV $U_ANY 3
03E5: "UNION active/value:"
03E5: $UA
03E5: $UV

0B14: 4 $C_ACTOR
0B13: $C_ACTOR 0 SCML_KIND_CLASS
0B13: $C_ACTOR 1 2
0B13: $C_ACTOR 2 42
0B13: $C_ACTOR 3 1
0B12: $CID $C_ACTOR 2
0B12: $FC $C_ACTOR 1
03E5: "CLASS id/field_count:"
03E5: $CID
03E5: $FC

0B11: $S_PLAYER
0B11: $U_ANY
0B11: $C_ACTOR
0001:
