; numerics_plus.scmlh - bit, math, chrono and random helpers.
#pragma once

macro bit_cast(lhs_value, rhs_value, out_value) {
    0B31: "numeric.bit_cast" lhs_value rhs_value
    0004: out_value $RETVAL
}

