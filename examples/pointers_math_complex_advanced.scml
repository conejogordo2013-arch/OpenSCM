use "../std.scmlh";

:MAIN
PTR_NEW_STRUCT(3, 0@)
PTR_SET(0@, 0, 10)
PTR_SET(0@, 1, 20)
PTR_SET(0@, 2, 30)

PTR_NEW_STRUCT(3, 1@)
PTR_COPY3(1@, 0@)
PTR_GET(2@, 1@, 2)
PRINT(2@)

MATH_POW2(3@, 9)
MATH_POW3(4@, 4)
MATH_CLAMP(5@, 140, 0, 100)
MATH_LERP_I32(6@, 10, 30, 1, 2)
PRINT(3@)
PRINT(4@)
PRINT(5@)
PRINT(6@)

COMPLEX_NEW(10@, 2, 3)
COMPLEX_NEW(11@, 4, 5)
COMPLEX_NEW(12@, 0, 0)
COMPLEX_ADD(12@, 10@, 11@)
PTR_GET(13@, 12@, 0)
PTR_GET(14@, 12@, 1)
PRINT(13@)
PRINT(14@)

COMPLEX_MUL(12@, 10@, 11@)
PTR_GET(15@, 12@, 0)
PTR_GET(16@, 12@, 1)
PRINT(15@)
PRINT(16@)

PTR_FREE_SAFE(0@)
PTR_FREE_SAFE(1@)
PTR_FREE_SAFE(10@)
PTR_FREE_SAFE(11@)
PTR_FREE_SAFE(12@)
END_THREAD()
