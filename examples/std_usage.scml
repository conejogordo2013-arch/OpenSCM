use "../std.scmlh";

script MAIN {
    print("std.scmlh demo");
    let $counter: i32 = 0;
    array_new($values, 3);
    array_set($values, 0, 7);
    array_set($values, 1, 11);
    array_set($values, 2, 13);
    call SUM_VALUES;

    if ($total > 20) {
        print("total is big");
    } else {
        print("total is small");
    }

    print($total);
}

fn SUM_VALUES() {
    let $i: i32 = 0;
    let $total: i32 = 0;

    while ($i < 3) {
        array_get($item, $values, $i);
        add($total, $total, $item);
        $i += 1;
    }
}
