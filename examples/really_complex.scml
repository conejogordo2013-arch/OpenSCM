#include "../std.scmlh"

:MAIN
03E5: "~b~OpenSCM ~w~// SCM STYLE BOOT"
03E5: "03A4: name_thread 'MAIN'"
03E5: "01F0/0111/00C0 bootstrap emulation"

0004: $MISSION_STATE 1
0004: $CLOCK_HOUR 23
0004: $CLOCK_MINUTE 0
0004: $PLAYER_NAME "CJ"
0004: $ZONE_NAME "Los Santos"
0004: $ONMISSION 1

0B14: 8 $MISSION_DATA
0B13: $MISSION_DATA 0 12
0B13: $MISSION_DATA 1 7
0B13: $MISSION_DATA 2 3
0B13: $MISSION_DATA 3 15
0B13: $MISSION_DATA 4 20
0B13: $MISSION_DATA 5 5
0B13: $MISSION_DATA 6 9
0B13: $MISSION_DATA 7 11

0004: $IDX 0
0004: $TOTAL_RISK 0
:MAIN_LOOP
IF_LT($IDX, 8, @ACCUMULATE_RISK)
000A: @RISK_DONE
:ACCUMULATE_RISK
0B12: $CELL $MISSION_DATA $IDX
0006: $TOTAL_RISK $TOTAL_RISK $CELL
0006: $IDX $IDX 1
000A: @MAIN_LOOP
:RISK_DONE

03E5: "Risk aggregate loaded"
03E5: $TOTAL_RISK

0D00: @CALC_REPUTATION
0D00: @CALC_CLEARANCE
0D00: @BUILD_HEAP_SNAPSHOT

03E5: "Player:"
03E5: $PLAYER_NAME
03E5: "Zone:"
03E5: $ZONE_NAME
03E5: "Reputation:"
03E5: $REPUTATION
03E5: "Clearance:"
03E5: $CLEARANCE
03E5: "Snapshot:"
03E5: $HEAP_SNAPSHOT

EVENT_BIND("ON_COMPLEX_EVENT", @ON_COMPLEX_EVENT_A)
EVENT_BIND("ON_COMPLEX_EVENT", @ON_COMPLEX_EVENT_B)
TRIGGER_EVENT("ON_COMPLEX_EVENT")
03E5: "Dispatch sequence queued"
END_SCRIPT()

:CALC_REPUTATION
0008: $TMP_A $TOTAL_RISK 2
0008: $TMP_B $MISSION_STATE 33
0006: $TMP_C $TMP_A $TMP_B
0009: $TMP_D $TMP_C 3
0006: $REPUTATION $TMP_D 40
0D01:

:CALC_CLEARANCE
IF_GT($REPUTATION, 120, @CLEARANCE_HIGH)
IF_GT($REPUTATION, 90, @CLEARANCE_MED)
0004: $CLEARANCE "LOW"
0D01:
:CLEARANCE_MED
IF_EQ($ONMISSION, 1, @CLEARANCE_MED_ACTIVE)
0004: $CLEARANCE "MED"
0D01:
:CLEARANCE_MED_ACTIVE
0004: $CLEARANCE "MED_ACTIVE"
0D01:
:CLEARANCE_HIGH
0004: $CLEARANCE "HIGH"
0D01:

:BUILD_HEAP_SNAPSHOT
0C00: 4 $HEAP
0C01: $HEAP 0 $TOTAL_RISK
0C01: $HEAP 1 $REPUTATION
0C01: $HEAP 2 $MISSION_STATE
0C01: $HEAP 3 $CLOCK_HOUR
0C02: $HEAP_SNAPSHOT $HEAP 1
FREE($HEAP)
0D01:

:ON_COMPLEX_EVENT_A
03E5: "[A] world tick"
03E5: "[A] time"
03E5: $CLOCK_HOUR
03E5: $CLOCK_MINUTE
03E5: "[A] clearance"
03E5: $CLEARANCE
0D02:

:ON_COMPLEX_EVENT_B
0004: $AUTH 0
IF_EQ($CLEARANCE, "HIGH", @AUTH_OK)
IF_EQ($CLEARANCE, "MED_ACTIVE", @AUTH_OK)
000A: @AUTH_PRINT
:AUTH_OK
0004: $AUTH 1
:AUTH_PRINT
03E5: "[B] auth flag"
03E5: $AUTH
03E5: "~g~Mission logic complete."
0D02:
