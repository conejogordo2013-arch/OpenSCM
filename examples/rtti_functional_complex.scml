#include "rtti_functional_complex.scmlh"

:MAIN
03E5: "=== BOOT ==="
03E5: BUILD_NAME
03E5: __scml

0004: $RUN 1
0004: $TICK 0
0004: $HP 120
0004: $SCORE 0
0004: $KILLS 0
0004: $EVT_COUNT 0
0004: $ERRS 0

; pseudo pointers (handles)
0004: $PTR_PLAYER 1000
0004: $PTR_ENEMY 2000
0004: $PTR_BOSS 3000

; RTTI type table in vars
0004: $TYPE_0 TYPE_PLAYER
0004: $TYPE_1 TYPE_ENEMY
0004: $TYPE_2 TYPE_BOSS

; state table in vars
0004: $STATE_0 1
0004: $STATE_1 1
0004: $STATE_2 1

; hp table in vars
0004: $HP_0 120
0004: $HP_1 40
0004: $HP_2 200

0006: $EVT_COUNT $EVT_COUNT 1

:LOOP
000B: 0
00D6: $RUN 0 @SHUTDOWN
0006: $TICK $TICK 1

; periodic damage
0007: 10@ $TICK 4
00D8: 10@ 0 @NO_DAMAGE
0007: $HP_0 $HP_0 6
0004: $HP $HP_0
0006: $EVT_COUNT $EVT_COUNT 1
:NO_DAMAGE

; dispatch obj0
00D6: $STATE_0 1 @OBJ1
00D6: $TYPE_0 TYPE_PLAYER @OBJ1
0007: 20@ $TICK 9
00D8: 20@ 0 @OBJ1
0006: $HP_0 $HP_0 1
0004: $HP $HP_0

:OBJ1
00D6: $STATE_1 1 @OBJ2
00D6: $TYPE_1 TYPE_ENEMY @OBJ2
0007: $HP_1 $HP_1 2
00D9: $HP_1 1 @OBJ2
0004: $STATE_1 0
0006: $KILLS $KILLS 1
0006: $SCORE $SCORE 50
0006: $EVT_COUNT $EVT_COUNT 1

:OBJ2
00D6: $STATE_2 1 @ENDCOND
00D6: $TYPE_2 TYPE_BOSS @ENDCOND
0007: $HP_2 $HP_2 1
00D9: $HP_2 1 @ENDCOND
0004: $STATE_2 0
0006: $KILLS $KILLS 1
0006: $SCORE $SCORE 200
0006: $EVT_COUNT $EVT_COUNT 1

:ENDCOND
00D9: $HP 1 @END_NOW
00D8: $TICK 50 @END_NOW
JUMP @LOOP

:END_NOW
0004: $RUN 0
JUMP @LOOP

:SHUTDOWN
03E5: "=== FINAL REPORT ==="
03E5: "TICK"
03E5: $TICK
03E5: "HP"
03E5: $HP
03E5: "SCORE"
03E5: $SCORE
03E5: "KILLS"
03E5: $KILLS
03E5: "EVENTS"
03E5: $EVT_COUNT
03E5: "PTR_PLAYER"
03E5: $PTR_PLAYER
03E5: "PTR_ENEMY"
03E5: $PTR_ENEMY
03E5: "PTR_BOSS"
03E5: $PTR_BOSS
0D02:
