; Cubo giratorio OpenGL usando SOLO SCML + FFI dinamico.
; Linux: requiere libglfw.so.3 y libGL.so.1 instaladas.

:MAIN
03E5: "SCML FFI OpenGL cube starting on Linux"
0B31: "ffi.load" "libglfw.so.3" 9
0004: $GLFW_LIB $RETVAL
0B31: "ffi.load" "libGL.so.1" 9
0004: $OPENGL_LIB $RETVAL

0B31: "ffi.call_name" "glfwInit" "int" ""
0004: $GLFW_OK $RETVAL
00D6: $GLFW_OK 0 @FAIL

0B31: "ffi.call_name" "glfwCreateWindow" "pointer" "int,int,string,pointer,pointer" 800 600 "SCML FFI OpenGL Cube" 0 0
0004: $WINDOW $RETVAL
0B31: "ffi.is_null" $WINDOW
0004: $WINDOW_NULL $RETVAL
00D6: $WINDOW_NULL 1 @FAIL_TERMINATE

0B31: "ffi.call_name" "glfwMakeContextCurrent" "void" "pointer" $WINDOW
0B31: "ffi.call_name" "glfwSwapInterval" "void" "int" 1
0B31: "ffi.call_name" "glViewport" "void" "int,int,int,int" 0 0 800 600
0B31: "ffi.call_name" "glEnable" "void" "uint32" 2929
0004: $ANGLE 0.0

:FRAME
0B31: "ffi.call_name" "glfwWindowShouldClose" "int" "pointer" $WINDOW
0004: $SHOULD_CLOSE $RETVAL
00D7: $SHOULD_CLOSE 0 @CLEANUP

0B31: "ffi.call_name" "glClearColor" "void" "float,float,float,float" 0.03 0.05 0.10 1.0
