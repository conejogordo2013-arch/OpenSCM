; SCMLh compatibility layer to write C++-like intent with SCM visual style.
; Directives supported in engine: #include, #define, macro/endmacro.
; This header adds aliases so script authors can express many C++ concepts in SCML shape.

#define __scml 1

; --- Preprocessor-like aliases ---
#define include_scmlh #include
#define define_scml #define
#define undef_scml #undef

; --- Fundamental type aliases (symbolic in SCML) ---
#define bool_t BOOL
#define int_t INT
#define uint_t UINT
#define float_t FLOAT
#define double_t DOUBLE
#define void_t VOID

; --- Literals / constants helpers ---
#define TRUE 1
#define FALSE 0
#define NULLPTR 0

; --- Operators expressed as macros using existing opcodes ---
macro ASSIGN(dst, value) {
    dst = value
}
macro ADD_ASSIGN(dst, value) {
    dst += value
}
macro SUB_ASSIGN(dst, value) {
    dst -= value
}
macro INC(dst) {
    dst += 1
}
macro DEC(dst) {
    dst -= 1
}

; --- Comparison helpers map to IF opcodes ---
macro IF_EQ(a, b, label) {
    00D6: a b label
}
macro IF_NE(a, b, label) {
    00D7: a b label
}
macro IF_GT(a, b, label) {
    00D8: a b label
}
macro IF_LT(a, b, label) {
    00D9: a b label
}

; --- Flow helpers ---
macro GOTO(label) {
    jump label
}
macro RETURN() {
    return
}
macro BREAK_THREAD() {
    end_thread
}

; --- Function bridge helpers ---
macro CALL_NATIVE(name, a) {
    CALL name a
}
macro CALL_NATIVE3(name, a, b, c) {
    CALL name a b c
}

; --- Memory / array helpers ---
macro NEW_ARRAY(size, outref) {
    0B14: size outref
}
macro DELETE_ARRAY(ref) {
    0B11: ref
}
macro ARRAY_SET(ref, idx, value) {
    0B13: ref idx value
}
macro ARRAY_GET(outvar, ref, idx) {
    0B12: outvar ref idx
}

; --- Entity helpers ---
macro NEW_ENTITY(model, x, y, z, outid) {
    0B00: model x y z outid
}

; --- Logging ---
macro LOG_MSG(msg) {
    03E5: msg
}
macro LOG_FILE(path, msg) {
    0A20: path msg
}
